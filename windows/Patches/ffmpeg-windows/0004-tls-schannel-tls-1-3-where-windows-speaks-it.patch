+/* Whether this Windows speaks TLS 1.3 as a client: Windows 11 and Windows
+ * Server 2022 (build 20348) and later do, given credentials in the newer
+ * form (SCH_CREDENTIALS); Windows 10 does not. The build is asked of ntdll,
+ * whose answer, unlike GetVersionEx's and VerifyVersionInfo's, does not
+ * depend on the program's manifest. */
+static int tls_windows_speaks_tls13(void)
+{
+    typedef LONG (WINAPI *get_version_function)(OSVERSIONINFOW *);
+    OSVERSIONINFOW version = { .dwOSVersionInfoSize = sizeof(version) };
+    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    get_version_function get_version =
+        ntdll ? (get_version_function)(void *)GetProcAddress(ntdll, "RtlGetVersion") : NULL;
+
+    return get_version && get_version(&version) == 0 &&
+           (version.dwMajorVersion > 10 ||
+            (version.dwMajorVersion == 10 && version.dwBuildNumber >= 20348));
+}
