+
+/* The SHA-256 of a certificate as it was sent: what a person compares two
+ * certificates by. Written as 64 lower-case hexadecimal digits. */
+static int cert_sha256(PCCERT_CONTEXT cert, char hex[65])
+{
+    struct AVSHA *sha;
+    uint8_t digest[32];
+
+    if (!cert || !cert->pbCertEncoded || !cert->cbCertEncoded)
+        return AVERROR_UNKNOWN;
+    if (!(sha = av_sha_alloc()))
+        return AVERROR(ENOMEM);
+    av_sha_init(sha, 256);
+    av_sha_update(sha, cert->pbCertEncoded, cert->cbCertEncoded);
+    av_sha_final(sha, digest);
+    av_free(sha);
+    ff_data_to_hex(hex, digest, sizeof(digest), 1);
+    return 0;
+}
+
+/* Whether a digest as a caller wrote it, in either case and with or without
+ * colons between its bytes, is the one in `hex`. */
+static int is_sha256(const char *stated, const char *hex)
+{
+    for (; *stated; stated++) {
+        if (*stated == ':' || *stated == ' ')
+            continue;
+        if (!*hex || av_tolower(*stated) != *hex)
+            return 0;
+        hex++;
+    }
+    return !*hex;
+}
+
+/* Judges the certificate a server showed, in SChannel's place, when a
+ * handshake is through and before anything is sent or read over it. The
+ * certificate the caller said it trusts (`trusted_cert_sha256`) is taken as
+ * it is: whatever else is the matter with it (no root, run out, written for
+ * another name), the peer that shows it holds its key, and that certificate
+ * is what was trusted. Any other is judged as Windows judges a server's:
+ * its chain is built to a root the system trusts, and held against the
+ * rules for a TLS server and against the name that was asked for. One that
+ * is turned down is kept, so that the caller can be told which it was.
+ *
+ * Whether a certificate of the chain has been revoked is read from what
+ * Windows already knows and is not asked of the network: a handshake does
+ * not wait for a certificate authority's server, and does not fail because
+ * one cannot be reached. A certificate known to be revoked is turned down.
+ *
+ * 0, or FFERRTAG(0xF8,'C','R','T') for a certificate that is not trusted. */
+static int tls_verify_server(URLContext *h)
+{
+    static const char *const usages[] = {
+        szOID_PKIX_KP_SERVER_AUTH, szOID_SERVER_GATED_CRYPTO, szOID_SGC_NETSCAPE,
+    };
+    TLSContext *c = h->priv_data;
+    TLSShared *s = &c->tls_shared;
+    PCCERT_CONTEXT cert = NULL;
+    PCCERT_CHAIN_CONTEXT chain = NULL;
+    CERT_CHAIN_PARA chain_para = { 0 };
+    SSL_EXTRA_CERT_CHAIN_POLICY_PARA ssl_para = { 0 };
+    CERT_CHAIN_POLICY_PARA policy_para = { 0 };
+    CERT_CHAIN_POLICY_STATUS policy_status = { 0 };
+    SECURITY_STATUS sspi_ret;
+    wchar_t *host = NULL;
+    char shown[65] = "";
+    int ret = FFERRTAG(0xF8, 'C', 'R', 'T');
 
+    sspi_ret = QueryContextAttributes(&c->ctxt_handle, SECPKG_ATTR_REMOTE_CERT_CONTEXT, &cert);
+    if (sspi_ret != SEC_E_OK || !cert) {
+        av_log(h, AV_LOG_ERROR, "The peer showed no certificate (0x%lx)\n", sspi_ret);
+        cert = NULL;
+        goto end;
+    }
+
+    if (cert_sha256(cert, shown) < 0)
+        shown[0] = 0;
+    if (c->trusted_cert_sha256 && shown[0] && is_sha256(c->trusted_cert_sha256, shown)) {
+        ret = 0;
+        goto end;
+    }
+
+    /* The chain, from the certificate the server showed for itself and the
+     * ones it sent along (which are in that certificate's store), to a root
+     * of the system's. */
+    chain_para.cbSize = sizeof(chain_para);
+    chain_para.RequestedUsage.dwType = USAGE_MATCH_TYPE_OR;
+    chain_para.RequestedUsage.Usage.cUsageIdentifier = FF_ARRAY_ELEMS(usages);
+    chain_para.RequestedUsage.Usage.rgpszUsageIdentifier = (LPSTR *)usages;
+    if (!CertGetCertificateChain(NULL, cert, NULL, cert->hCertStore, &chain_para,
+                                 CERT_CHAIN_REVOCATION_CHECK_CHAIN_EXCLUDE_ROOT |
+                                 CERT_CHAIN_REVOCATION_CHECK_CACHE_ONLY,
+                                 NULL, &chain)) {
+        av_log(h, AV_LOG_ERROR, "No chain could be built for the peer's certificate (0x%lx)\n", GetLastError());
+        chain = NULL;
+        goto refused;
+    }
+
+    /* The rules for a TLS server, and the name. Without a name to hold the
+     * certificate against there is none to check, as SChannel has it too. */
+    if (s->host) {
+        int length = MultiByteToWideChar(CP_UTF8, 0, s->host, -1, NULL, 0);
+        host = length > 0 ? av_calloc(length, sizeof(*host)) : NULL;
+        if (!host) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        MultiByteToWideChar(CP_UTF8, 0, s->host, -1, host, length);
+    }
+    ssl_para.cbSize = sizeof(ssl_para);
+    ssl_para.dwAuthType = AUTHTYPE_SERVER;
+    ssl_para.pwszServerName = host;
+    policy_para.cbSize = sizeof(policy_para);
+    policy_para.dwFlags = CERT_CHAIN_POLICY_IGNORE_ALL_REV_UNKNOWN_FLAGS;
+    policy_para.pvExtraPolicyPara = &ssl_para;
+    policy_status.cbSize = sizeof(policy_status);
+    if (!CertVerifyCertificateChainPolicy(CERT_CHAIN_POLICY_SSL, chain, &policy_para, &policy_status)) {
+        av_log(h, AV_LOG_ERROR, "The peer's certificate could not be judged (0x%lx)\n", GetLastError());
+        goto refused;
+    }
+    if (policy_status.dwError) {
+        av_log(h, AV_LOG_ERROR, "The peer's certificate is not trusted (0x%lx)\n", policy_status.dwError);
+        goto refused;
+    }
+    ret = 0;
+    goto end;
+
+refused:
+    av_strlcpy(c->refused_cert_sha256, shown, sizeof(c->refused_cert_sha256));
+end:
+    av_free(host);
+    if (chain)
+        CertFreeCertificateChain(chain);
+    if (cert)
+        CertFreeCertificateContext(cert);
+    return ret;
+}
+
