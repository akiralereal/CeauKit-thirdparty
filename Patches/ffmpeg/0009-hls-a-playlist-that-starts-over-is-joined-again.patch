+
+/* An origin that starts over numbers its segments from where it pleases,
+ * as a rule from nought, and the reader is left waiting for a number that
+ * the new list will not reach for days: it asked max_reload times and then
+ * took the stream to have ended.
+ *
+ * A list that has only fallen behind, as that of one server among several
+ * may, still reaches where the list before it began. One whose segments
+ * all lie before that is another list, and is joined where a reader that
+ * opened it now would join it.
+ *
+ * The timestamps start over with the numbers. A timestamp far below the
+ * first one that was read is otherwise taken for a counter that has gone
+ * round, and has a round added to it, which in a transport stream is
+ * twenty-six hours. From here on timestamps are passed on as they come. */
+static void join_restarted_playlist(HLSContext *c, struct playlist *v)
+{
+    AVFormatContext *contexts[2] = { v->parent, v->ctx };
+    int64_t waited_for = v->cur_seq_no;
+
+    v->cur_seq_no = v->start_seq_no + (c->live_start_index < 0 ?
+        FFMAX(v->n_segments + c->live_start_index, 0) :
+        FFMIN(c->live_start_index, v->n_segments - 1));
+    v->last_seq_no = v->cur_seq_no;
+    v->m3u8_hold_counters = 0;
+    c->cur_seq_no = v->cur_seq_no;
+
+    /* What was asked for ahead of time is a segment of the old list. */
+    ff_format_io_close(v->parent, &v->input_next);
+    v->input_next_requested = 0;
+    v->input_reuse = 0;
+
+    for (int i = 0; i < 2; i++) {
+        AVFormatContext *s = contexts[i];
+        if (!s)
+            continue;
+        for (unsigned j = 0; j < s->nb_streams; j++)
+            ffstream(s->streams[j])->pts_wrap_behavior = AV_PTS_WRAP_IGNORE;
+        for (unsigned j = 0; j < s->nb_programs; j++)
+            s->programs[j]->pts_wrap_behavior = AV_PTS_WRAP_IGNORE;
+    }
+
+    av_log(v->parent, AV_LOG_WARNING,
+           "playlist %d has started over: it ends at segment %"PRId64
+           " and segment %"PRId64" was waited for, carrying on at %"PRId64"\n",
+           v->index, v->start_seq_no + v->n_segments - 1, waited_for,
+           v->cur_seq_no);
 }
 
