             av_log(pls->parent, AV_LOG_VERBOSE, "new fragment: min[%"PRId64"] max[%"PRId64"]\n", min_seq_no, max_seq_no);
         }
+        /* A segment the manifest does not list yet, or that the clock says
+         * is not made yet, is not there: asked for now it is not found, and
+         * passed over, and the next one with it, as fast as they can be
