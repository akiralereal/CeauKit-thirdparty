+
+/* The SHA-256 of the certificate a peer showed for itself, the first of its
+ * chain, over the certificate as it was sent: what a person compares two
+ * certificates by. Written as 64 lower-case hexadecimal digits. */
+static int peer_cert_sha256(SecTrustRef trust, char hex[65])
+{
+    CFArrayRef chain = SecTrustCopyCertificateChain(trust);
+    CFDataRef der = NULL;
+    struct AVSHA *sha = NULL;
+    uint8_t digest[32];
+    int ret = AVERROR_UNKNOWN;
+
+    if (!chain || CFArrayGetCount(chain) < 1)
+        goto end;
+    der = SecCertificateCopyData((SecCertificateRef)CFArrayGetValueAtIndex(chain, 0));
+    if (!der)
+        goto end;
+    if (!(sha = av_sha_alloc())) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    av_sha_init(sha, 256);
+    av_sha_update(sha, CFDataGetBytePtr(der), CFDataGetLength(der));
+    av_sha_final(sha, digest);
+    ff_data_to_hex(hex, digest, sizeof(digest), 1);
+    ret = 0;
+
+end:
+    av_free(sha);
+    if (der)
+        CFRelease(der);
+    if (chain)
+        CFRelease(chain);
+    return ret;
+}
+
+/* Whether a digest as a caller wrote it, in either case and with or without
+ * colons between its bytes, is the one in `hex`. */
+static int is_sha256(const char *stated, const char *hex)
+{
+    for (; *stated; stated++) {
+        if (*stated == ':' || *stated == ' ')
+            continue;
+        if (!*hex || av_tolower(*stated) != *hex)
+            return 0;
+        hex++;
     }
+    return !*hex;
 }
 
