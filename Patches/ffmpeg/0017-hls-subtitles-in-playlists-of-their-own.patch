+/* Puts a playlist of subtitles that is wanted from now on where the time
+ * being shown is. Left to itself it starts at the time last read, which
+ * is ahead of that by all that waits to be played: the cue that is up at
+ * this moment, and those of the next seconds, would never be seen. */
+static void start_subtitles_at(HLSContext *c, struct playlist *pls, int64_t shown)
+{
+    if (pls->finished) {
+        /* The place of each segment is known from the lengths of those
+         * before it, once the first timestamp is. */
+        if (c->first_timestamp != AV_NOPTS_VALUE)
+            find_timestamp_in_playlist(c, pls, shown, &pls->cur_seq_no, NULL);
+    } else if (c->cur_timestamp != AV_NOPTS_VALUE && c->cur_timestamp > shown &&
+               pls->target_duration > 0) {
+        /* A list that moves on says nothing of when its segments are:
+         * as many of them back as the time takes up at most. */
+        int64_t back = (c->cur_timestamp - shown + pls->target_duration - 1) / pls->target_duration;
+        pls->cur_seq_no = FFMAX(pls->cur_seq_no - back, pls->start_seq_no);
+    }
+    pls->seek_timestamp = shown;
+    pls->seek_flags = AVSEEK_FLAG_ANY;
+    pls->seek_stream_index = -1;
+}
