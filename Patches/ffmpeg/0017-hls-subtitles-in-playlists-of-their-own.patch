+/* Whether this cue was in the segment before the one it is read from. It
+ * is noted as one of this segment's either way: a cue that stays up over
+ * three segments is in all three. */
+static int cue_was_read(struct playlist *v, const AVPacket *pkt)
+{
+    struct cue_mark mark = { pkt->pts, pkt->duration,
+        av_crc(av_crc_get_table(AV_CRC_32_IEEE), 0, pkt->data, pkt->size) };
+    int i, found = 0;
+
+    for (i = 0; i < v->n_cues_before && !found; i++)
+        found = v->cues_before[i].pts == mark.pts &&
+                v->cues_before[i].duration == mark.duration &&
+                v->cues_before[i].sum == mark.sum;
+    if (v->n_cues_now < MAX_CUE_MARKS)
+        v->cues_now[v->n_cues_now++] = mark;
+    return found;
+}
+
+/* A timestamp of a transport stream is 33 bits long and starts over every
+ * twenty-six and a half hours. The other playlists' timestamps are carried
+ * on past that by their demuxers; a cue time made from an X-TIMESTAMP-MAP
+ * has started over with the number it was made from. It is put within
+ * half a round of what was last read. */
+static void carry_cue_past_the_wrap(HLSContext *c, AVPacket *pkt)
+{
+    const int64_t round = av_rescale(INT64_C(1) << 33, 1000, 90000);
+    int64_t read, away;
+
+    if (c->cur_timestamp == AV_NOPTS_VALUE || pkt->pts == AV_NOPTS_VALUE)
+        return;
+    read = av_rescale(c->cur_timestamp, 1000, AV_TIME_BASE);
+    away = read - pkt->pts;
+    if (away > round / 2)
+        away = (away + round / 2) / round * round;
+    else if (away < -round / 2)
+        away = -((-away + round / 2) / round * round);
+    else
+        return;
+    pkt->pts += away;
+    if (pkt->dts != AV_NOPTS_VALUE)
+        pkt->dts += away;
 }
 
+/* Whether the segment a playlist of subtitles is at begins after what the
+ * other playlists have been read to. Known for a list that is complete,
+ * where the place of each segment follows from the lengths of those
+ * before it; a list that moves on ends where there is nothing more to
+ * read anyway. */
+static int subtitle_segment_is_ahead(HLSContext *c, struct playlist *v)
+{
+    int64_t n = v->cur_seq_no - v->start_seq_no, start = c->first_timestamp;
+
+    if (!v->finished || n <= 0 || n >= v->n_segments ||
+        c->first_timestamp == AV_NOPTS_VALUE || c->cur_timestamp == AV_NOPTS_VALUE)
+        return 0;
+    for (int64_t i = 0; i < n; i++)
+        start += v->segments[i]->duration;
+    return start > c->cur_timestamp;
+}
