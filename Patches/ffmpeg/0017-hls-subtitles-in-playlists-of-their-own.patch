+/* Fetches a playlist of subtitles that was left alone when the others
+ * were read. One that will not come is asked for again in a while, and
+ * costs nothing but its subtitles meanwhile. */
+static int load_subtitle_playlist(HLSContext *c, struct playlist *pls)
+{
+    int ret;
+
+    if (pls->wait_until && av_gettime_relative() < pls->wait_until)
+        return AVERROR(EAGAIN);
+    ret = parse_playlist(c, pls->url, pls, NULL);
+    if (ret >= 0 && pls->n_segments == 0)
+        ret = AVERROR(EAGAIN);
+    if (ret < 0) {
+        if (ret != AVERROR_EXIT)
+            av_log(c->ctx, AV_LOG_WARNING, "subtitle playlist %d could not be read: %s [%s]\n",
+                   pls->index, av_err2str(ret), pls->url);
+        pls->wait_until = av_gettime_relative() + 2 * AV_TIME_BASE;
+        return ret;
+    }
+    pls->wait_until = 0;
+    pls->not_loaded = 0;
+    return 0;
+}
