+static int find_mc_pair(uint8_t *pair, int target_index, int nb_channels)
+{
+    int index = 0;
+    for (int j = 0; j < nb_channels - 1; j++) {
+        for (int i = j + 1; i < nb_channels; i++) {
+            if (index == target_index) {
+                pair[0] = j;
+                pair[1] = i;
+                return 0;
+            }
+            index++;
+        }
+    }
+
+    return -1;
+}
