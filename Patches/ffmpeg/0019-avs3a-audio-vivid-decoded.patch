+/* T/AI 109.3-2023 Table A.8 */
+static int set_ch_layout(void *ctx, AVChannelLayout *ch_layout, unsigned int idx)
+{
+    switch (idx) {
+    case 0x0: *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_MONO; break;
+    case 0x1: *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_STEREO; break;
+    case 0x2: *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_5POINT1; break;
+    case 0x3: *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_7POINT1; break;
+    case 0x4: /* 10.2 */
+    case 0x5: /* 22.2 */
+    case 0x6: /* 4.0 */
+        avpriv_request_sample(ctx, "multichannel");
+        return AVERROR_PATCHWELCOME;
+    case 0x7: *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_5POINT1POINT2; break;
+    case 0x8: *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_5POINT1POINT4_BACK; break;
+    case 0x9: *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_7POINT1POINT2; break;
+    case 0xa: *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_7POINT1POINT4_BACK; break;
+    default:
+        return AVERROR_INVALIDDATA;
+    }
+    return 0;
