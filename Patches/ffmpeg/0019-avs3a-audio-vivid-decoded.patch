diff --git a/libavcodec/avs3a_parser.c b/libavcodec/avs3a_parser.c
new file mode 100644
index 0000000..a3e0fb2
--- /dev/null
+++ b/libavcodec/avs3a_parser.c
@@ -0,0 +1,138 @@
+/*
+ * AVS3-P3/AVS3A/Audio Vivid parser
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "avs3a_header.h"
+#include "parser.h"
+#include "parser_internal.h"
+
+typedef struct {
+    ParseContext pc;
+    uint8_t header_buf[AVS3A_MAX_HEADER_SIZE + AV_INPUT_BUFFER_PADDING_SIZE];
+    int packet_size;
+    AVS3AHeader header;
+} AVS3AParseContext;
+
+static int determine_next(AVS3AParseContext *pc, int buf_size)
+{
+    if (pc->packet_size <= buf_size) {
+        int next = pc->packet_size;
+        pc->packet_size = 0;
+        return next;
+    }
+    pc->packet_size -= buf_size;
+    return END_NOT_FOUND;
+}
+
+static int parse_header(AVCodecParserContext *s, AVCodecContext *avctx, uint8_t *header_buf)
+{
+    AVS3AParseContext *pc = s->priv_data;
+    GetBitContext gb;
+    init_get_bits8(&gb, header_buf, AVS3A_MAX_HEADER_SIZE);
+
+    AVS3AHeader header = {0};
+    int header_size, sample_rate;
+    uint16_t crc;
+    int size = ff_avs3a_parse_header(avctx, &gb, &header_size, &header, &sample_rate, &crc);
+    if (size < 0)
+        return size;
+
+    if (memcmp(&pc->header, &header, sizeof(AVS3AHeader)) || avctx->sample_rate != sample_rate) {
+        AVChannelLayout ch_layout = {0};
+        int ret = ff_avs3a_get_ch_layout(avctx, &header, &ch_layout);
+
+        if (ret < 0)
+            return ret;
+        av_channel_layout_uninit(&avctx->ch_layout);
+        avctx->ch_layout = ch_layout;
+        pc->header = header;
+        avctx->sample_rate = sample_rate;
+        avctx->bit_rate = header.bitrate;
+    }
+    return size;
+}
+
+static int avs3a_parse(AVCodecParserContext *s, AVCodecContext *avctx,
+                       const uint8_t **poutbuf, int *poutbuf_size,
+                       const uint8_t *buf, int buf_size)
+{
+    AVS3AParseContext *pc = s->priv_data;
+    int next, skipped = 0;
+    int input_size = buf_size;
+
+    *poutbuf = NULL;
+    *poutbuf_size = 0;
+
+    if (s->flags & PARSER_FLAG_COMPLETE_FRAMES) {
+        next = buf_size;
+    } else {
+        if (!pc->packet_size) {
+            for (int i = 0; i < buf_size; i++) {
+                int packet_size, start;
+
+                memmove(pc->header_buf, pc->header_buf + 1, AVS3A_MAX_HEADER_SIZE - 1);
+                pc->header_buf[AVS3A_MAX_HEADER_SIZE - 1] = buf[i];
+                if (pc->header_buf[0] != 0xff || pc->header_buf[1] != 0xf2 ||
+                    (packet_size = parse_header(s, avctx, pc->header_buf)) <= 0)
+                    continue;
+
+                start = i + 1 - AVS3A_MAX_HEADER_SIZE;
+                if (start < 0) {
+                    const uint8_t *header = pc->header_buf;
+                    int header_bytes = -start;
+
+                    if (ff_combine_frame(&pc->pc, END_NOT_FOUND,
+                                         &header, &header_bytes) != -1) {
+                        memset(pc->header_buf, 0, AVS3A_MAX_HEADER_SIZE);
+                        return i + 1;
+                    }
+                    pc->packet_size = packet_size + start;
+                } else {
+                    skipped = start;
+                    buf += skipped;
+                    buf_size -= skipped;
+                    pc->packet_size = packet_size;
+                }
+                s->next_frame_offset = s->cur_offset + start;
+                ff_fetch_timestamp(s, start, 0, 0);
+                memset(pc->header_buf, 0, AVS3A_MAX_HEADER_SIZE);
+                break;
+            }
+
+            if (!pc->packet_size)
+                return input_size;
+        }
+
+        next = determine_next(pc, buf_size);
+        if (ff_combine_frame(&pc->pc, next, &buf, &buf_size) < 0)
+            return input_size;
+    }
+
+    *poutbuf = buf;
+    *poutbuf_size = buf_size;
+
+    return skipped + next;
+}
+
+const FFCodecParser ff_avs3a_parser = {
+    PARSER_CODEC_LIST(AV_CODEC_ID_AVS3A),
+    .priv_data_size = sizeof(AVS3AParseContext),
+    .parse          = avs3a_parse,
+    .close          = ff_parse_close,
+};
