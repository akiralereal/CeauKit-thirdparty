+#include "libavutil/mem_internal.h"
+#include "libavutil/opt.h"
+#include "libavutil/thread.h"
+#include "libavutil/tx.h"
+#include "avs3a_header.h"
+#include "avs3a_data.h"
+
+#define FFT_TABLE_SIZE 512
+
+#define SAMPLING_RATE 48000
+
+#define MAX_CHANNELS 16
+#define STEREO_CHANNELS 2
+#define LFE_CHANNEL_INDEX 3
+
+#define BLOCK_LEN_SHORT 128
+#define BLOCK_PADDING_SIZE 448
+#define N_BLOCK_SHORT (FRAME_LEN/BLOCK_LEN_SHORT)
+
+#define N_GROUP_SHORT_WIN 2
+
+#define HOA_OVERLAP_SIZE (FRAME_LEN/2)
+#define MAX_HOA_BASIS 4
+#define L_HOA_BASIS_ROWS MAX_CHANNELS
+#define N_BLOCK_HOA 2
+#define HOA_DELAY_BASIS 2
+
+#define SILENCE_BYTES 8
+
+#define LSF_MIN_GAP 50.0f
+
+#define MAX_NB_TNS_FILTER 2
+#define MAX_TNS_FILTER_ORDER 8
+
+typedef struct {
+    const float *data;
+    int nb_rows;
+    int nb_cols;
+} ConstMatrix;
+
+typedef struct {
+    float *data;
+    int nb_rows;
+    int nb_cols;
+} Matrix;
+
+typedef struct {
+    uint32_t base;
+    uint32_t size_minus_one;
+    uint32_t value;
+    GetBitContext *gb;
+    int nb_bytes;
+} RangeDecoder;
+
+typedef struct {
+    float input_padded[((FRAME_LEN / 16) + 2) * 16];
+    union {
+        struct {
+            float input_col[FRAME_LEN * 3];
+        } stride1;
+        struct {
+            float input_col_even[FRAME_LEN * 2];
+            float input_col_odd[FRAME_LEN * 3];
+            float output_tmp_even[FRAME_LEN / 2];
+            float output_tmp_odd[FRAME_LEN / 2];
+        } stride2;
+    } u;
+    float output[FRAME_LEN];
+    struct {
+        float inputT[FRAME_LEN];
+        float output[FRAME_LEN];
+    } igdn;
+} CNNScratch;
+
+typedef struct {
+    DECLARE_ALIGNED(32, float, spectrum)[MAX_CHANNELS][FRAME_LEN];
+    float synth_buffer[MAX_CHANNELS][HOA_OVERLAP_SIZE];
+    float delay_buffer[MAX_CHANNELS][FRAME_LEN + FRAME_LEN];
+    float *samples_ptr[MAX_CHANNELS];
+
+    int spatial_analysis;
+    int nb_virtuals;
+    uint16_t basis_idx[MAX_HOA_BASIS];
+    uint16_t delay_basis_idx[HOA_DELAY_BASIS][MAX_HOA_BASIS];
+
+    uint8_t ild[MAX_CHANNELS];
+    uint8_t pair_index[MAX_HOA_GROUPS][MAX_CHANNELS / 2];
+    uint8_t sfb_mask[MAX_HOA_GROUPS][MAX_CHANNELS / 2][FF_ARRAY_ELEMS(avs3a_hoa_sfb_lbr) - 1];
+    uint8_t nb_pairs[MAX_HOA_GROUPS];
+    uint8_t group_bits_ratio[MAX_HOA_GROUPS];
+    uint8_t bits_ratio[MAX_HOA_GROUPS][MAX_CHANNELS];
+
+    const HoaGroupConfig *config;
+    int nb_transport_channels;
+    uint8_t group_ch_offset[MAX_HOA_GROUPS];
+    uint8_t pair_index_bits[MAX_HOA_GROUPS];
+} AVS3AHOA;
+
+typedef struct {
+    int is_ms;
+    int ild;
+    int bits_ratio;
+
+    int mcr;
+    float theta[2][18];
+} AVS3AStereo;
+
+typedef struct {
+    float *spectrum_ptr[MAX_CHANNELS];
+    uint8_t sil_flag[MAX_CHANNELS];
+    int nb_pairs;
+    uint8_t pair[MAX_CHANNELS / 2][2];
+    uint8_t ild[MAX_CHANNELS];
+    int pair_index_bits;
+    int lf_ch_index;
+    int lfe_bytes;
+} AVS3AMC;
+
+typedef struct {
+    int enable;
+    int order;
+    float parcor_coeffs[MAX_TNS_FILTER_ORDER];
+} TNSParam;
+
+typedef struct {
+    DECLARE_ALIGNED(32, float, spectrum)[FRAME_LEN];
+    DECLARE_ALIGNED(32, float, samples)[FRAME_LEN];
+
+    int transform_type;
+#define ONLY_LONG_WINDOW  0
+#define ONLY_SHORT_WINDOW 1
+#define LONG_SHORT_TRANS_WINDOW 2
+#define SHORT_LONG_TRANS_WINDOW 3
+
+    int nb_mdct_groups;
+    uint8_t group_indicator[N_BLOCK_SHORT]; //0=transient block
+
+    int lsf_lbr;
+    uint8_t lsf_vq_index[7];
+
+    TNSParam tns_param[MAX_NB_TNS_FILTER];
+
+    int bwe_present;
+    const BweConfig *bwe_config;
+    uint8_t sfb_envelope_index[MAX_NUM_SFB_BWE];
+    uint8_t whitening_level[MAX_NUM_TILE];
+#define BWE_WHITENING_OFF 0
+#define BWE_WHITENING_MID 1
+#define BWE_WHITENING_HIGH 2
+
+    float feature_scale;
+    float nf_param[N_GROUP_SHORT_WIN];
+    int context_bytes;
+    int base_bytes;
+    GetBitContext gb;
+    CNNScratch scratch;
+    AVLFG lfg;
+} AVS3ACore;
+
+typedef struct {
+    AVClass *class;
+    AVCodecContext *avctx;
+    GetBitContext *gb;
+    AVS3AHeader header;
+
+    AVS3AHOA hoa;
+    AVS3AStereo stereo;
+    AVS3AMC mc;
+    AVS3ACore core[MAX_CHANNELS];
+
+    AVFloatDSPContext *fdsp;
+    AVTXContext *imdct_ctx, *imdct_short_ctx, *fft_ctx, *hoa_mdct_ctx, *hoa_imdct_ctx;
+    av_tx_fn imdct_fn, imdct_short_fn, fft_fn, hoa_mdct_fn, hoa_imdct_fn;
+} AVS3ADecoder;
+
+static const VLCElem *tns_coeff_vlc[8];
+static float parcor4[16];
+static float sin_table[256 + 1];
+static float short_window[BLOCK_LEN_SHORT];
+static float long_window[FRAME_LEN];
+static DECLARE_ALIGNED(32, float, hoa_window)[HOA_OVERLAP_SIZE];
+
+static void vector_fadd(float *dst, const float *src1, const float *src2, int len)
+{
+    for (int i = 0; i < len; i++)
+        dst[i] = src1[i] + src2[i];
+}
+
+static void vector_fcopy(float *dst, const float *src, int len)
+{
+    memcpy(dst, src, len*sizeof(float));
+}
+
+static void vector_fcopy_reverse(float *dst, const float *src, int len)
+{
+    for (int i = 0; i < len; i++)
+        dst[i] = src[-i - 1];
+}
+
+static void vector_fzero(float *dst, int len)
+{
+    memset(dst, 0, len*sizeof(float));
+}
+
+static void window_shape(AVS3ACore *core, float *win_left, float *win_right)
+{
+    if (core->transform_type == ONLY_LONG_WINDOW) {
+        vector_fcopy(win_left, long_window, FRAME_LEN);
+        vector_fcopy_reverse(win_right, long_window + FRAME_LEN, FRAME_LEN);
+    } else if (core->transform_type == ONLY_SHORT_WINDOW) {
+        vector_fcopy(win_left, short_window, BLOCK_LEN_SHORT);
+        vector_fcopy_reverse(win_right, short_window + BLOCK_LEN_SHORT, BLOCK_LEN_SHORT);
+    } else if (core->transform_type == LONG_SHORT_TRANS_WINDOW) {
+        vector_fcopy(win_left, long_window, FRAME_LEN);
+        vector_fcopy_reverse(win_right, short_window + BLOCK_LEN_SHORT, BLOCK_LEN_SHORT);
+    } else { // SHORT_LONG_TRANS_WINDOW
+        vector_fcopy(win_left, short_window, BLOCK_LEN_SHORT);
+        vector_fcopy_reverse(win_right, long_window + FRAME_LEN, FRAME_LEN);
+    }
+}
+
+static void window_signal(AVS3ADecoder *s, int transform_type, const float *input,
+                          float *output, const float *win_left, const float *win_right)
+{
+    if (transform_type == ONLY_LONG_WINDOW) {
+        s->fdsp->vector_fmul(output, win_left, input, FRAME_LEN);
+        s->fdsp->vector_fmul(output + FRAME_LEN, win_right, input + FRAME_LEN, FRAME_LEN);
+    } else if (transform_type == ONLY_SHORT_WINDOW) {
+        s->fdsp->vector_fmul(output, win_left, input, BLOCK_LEN_SHORT);
+        s->fdsp->vector_fmul(output + BLOCK_LEN_SHORT, win_right,
+                             input + BLOCK_LEN_SHORT, BLOCK_LEN_SHORT);
+    } else if (transform_type == LONG_SHORT_TRANS_WINDOW) {
+        s->fdsp->vector_fmul(output, win_left, input, FRAME_LEN);
+        vector_fcopy(output + FRAME_LEN, input + FRAME_LEN, BLOCK_PADDING_SIZE);
+        s->fdsp->vector_fmul(output + FRAME_LEN + BLOCK_PADDING_SIZE, win_right,
+                             input + FRAME_LEN + BLOCK_PADDING_SIZE, BLOCK_LEN_SHORT);
+        vector_fzero(output + FRAME_LEN + BLOCK_PADDING_SIZE + BLOCK_LEN_SHORT, BLOCK_PADDING_SIZE);
+    } else { // SHORT_LONG_TRANS_WINDOW
+        vector_fzero(output, BLOCK_PADDING_SIZE);
+        s->fdsp->vector_fmul(output + BLOCK_PADDING_SIZE, win_left,
+                             input + BLOCK_PADDING_SIZE, BLOCK_LEN_SHORT);
+        vector_fcopy(output + BLOCK_PADDING_SIZE + BLOCK_LEN_SHORT,
+                     input + BLOCK_PADDING_SIZE + BLOCK_LEN_SHORT, BLOCK_PADDING_SIZE);
+        s->fdsp->vector_fmul(output + BLOCK_PADDING_SIZE + BLOCK_LEN_SHORT + BLOCK_PADDING_SIZE,
+                             win_right, input + BLOCK_PADDING_SIZE + BLOCK_LEN_SHORT + BLOCK_PADDING_SIZE,
+                             FRAME_LEN);
+    }
+}
+
+static void interleave_spectrum(float *output, const float *input)
+{
+    for (int i = 0; i < N_BLOCK_SHORT; i++)
+        for (int j = 0; j < BLOCK_LEN_SHORT; j++)
+            output[i + N_BLOCK_SHORT * j] = input[i * BLOCK_LEN_SHORT + j];
+}
+
+static void deinterleave_spectrum(float *output, const float *input)
+{
+    for (int i = 0; i < N_BLOCK_SHORT; i++)
+        for (int j = 0; j < BLOCK_LEN_SHORT; j++)
+            output[i * BLOCK_LEN_SHORT + j] = input[i + N_BLOCK_SHORT * j];
+}
+
+static int count_nb_transient_blocks(const uint8_t *group_indicator)
+{
+    int nb_transient = 0;
+    for (int i = 0; i < N_BLOCK_SHORT; i++)
+        if (!group_indicator[i])
+            nb_transient++;
+    return nb_transient;
+}
+
+static void spectrum_degrouping(float *output, const float *input, const uint8_t *group_indicator)
+{
+    float tmp[FRAME_LEN];
+    int nb_transient = count_nb_transient_blocks(group_indicator);
+    int nb_other = N_BLOCK_SHORT - nb_transient;
+
+    for (int i = 0; i < nb_transient; i++)
+        for (int j = 0; j < BLOCK_LEN_SHORT; j++)
+            tmp[i * BLOCK_LEN_SHORT + j] = input[i + nb_transient * j];
+
+    for (int i = 0; i < nb_other; i++)
+        for (int j = 0; j < BLOCK_LEN_SHORT; j++)
+            tmp[(nb_transient + i) * BLOCK_LEN_SHORT + j] =
+                input[nb_transient * BLOCK_LEN_SHORT + nb_other * j + i];
+
+    int group = 0;
+    for (int i = 0; i < N_BLOCK_SHORT; i++) {
+        if (!group_indicator[i]) {
+            vector_fcopy(output + i * BLOCK_LEN_SHORT, tmp + group * BLOCK_LEN_SHORT,
+                         BLOCK_LEN_SHORT);
+            group++;
+        }
+    }
+
+    for (int i = 0; i < N_BLOCK_SHORT; i++) {
+        if (group_indicator[i]) {
+            vector_fcopy(output + i * BLOCK_LEN_SHORT, tmp + group * BLOCK_LEN_SHORT,
+                         BLOCK_LEN_SHORT);
+            group++;
+        }
+    }
+}
+
+/* calculate bits available after decode_qc() header */
+static int calc_available_bits(AVS3ADecoder *s, const uint8_t *nb_mdct_groups,
+                               int nb_channels)
+{
+    int used = get_bits_count(s->gb);
+
+    if (s->header.nn_type == NN_TYPE_BASIC)
+        used += nb_channels * (1 + 7 + 8);
+    else // NN_TYPE_LOW_COMPLEXITY
+        used += nb_channels * (8 + 8);
+
+    for (int ch = 0; ch < nb_channels; ch++)
+        used += nb_mdct_groups[ch] * 3;
+
+    return s->header.bits_per_frame - used;
+}
+
+static void matrix_mult(Matrix *m, const ConstMatrix *a, const ConstMatrix *b)
+{
+    for (int r = 0; r < m->nb_rows; r++) {
+        for (int c = 0; c < m->nb_cols; c++) {
+            int i = 0;
+            float sum1 = 0.0f, sum2 = 0.0f, sum3 = 0.0f, sum4 = 0.0f;
+            for (; i < a->nb_cols - 7; i += 8) {
+                sum1 += a->data[r * a->nb_cols + i]     * b->data[c * b->nb_cols + i];
+                sum1 += a->data[r * a->nb_cols + i + 1] * b->data[c * b->nb_cols + i + 1];
+
+                sum2 += a->data[r * a->nb_cols + i + 2] * b->data[c * b->nb_cols + i + 2];
+                sum2 += a->data[r * a->nb_cols + i + 3] * b->data[c * b->nb_cols + i + 3];
+
+                sum3 += a->data[r * a->nb_cols + i + 4] * b->data[c * b->nb_cols + i + 4];
+                sum3 += a->data[r * a->nb_cols + i + 5] * b->data[c * b->nb_cols + i + 5];
+
+                sum4 += a->data[r * a->nb_cols + i + 6] * b->data[c * b->nb_cols + i + 6];
+                sum4 += a->data[r * a->nb_cols + i + 7] * b->data[c * b->nb_cols + i + 7];
+            }
+
+            m->data[r * m->nb_cols + c] = (sum1 + sum2) + (sum3 + sum4);
+
+            float sum5 = 0.0f;
+            for (; i < a->nb_cols; i++)
+                sum5 += a->data[r * a->nb_cols + i] * b->data[c * b->nb_cols + i];
+
+            m->data[r * m->nb_cols + c] += sum5;
+        }
+    }
+}
+
+static int bwe_present(int coding_profile, int hoa_order, int bitrate, int nb_channels)
+{
+    if (coding_profile == CODING_PROFILE_HOA) {
+        if (hoa_order == 1) {
+            int cpe_bitrate = bitrate * STEREO_CHANNELS / nb_channels;
+            if (cpe_bitrate <= 128000)
+                return 1;
+        } else if (hoa_order == 2) {
+            if (bitrate <= 480000)
+                return 1;
+        } else {
+            return 1;
+        }
+    } else if (nb_channels == 1) {
+        if (bitrate <= 96000)
+            return 1;
+    } else if (nb_channels == 2) {
+        if (bitrate <= 128000)
+            return 1;
+    } else {
+        int cpe_bitrate = bitrate * STEREO_CHANNELS / nb_channels;
+        if (cpe_bitrate <= 128000)
+            return 1;
+    }
+
+    return 0;
+}
+
+static int bwe_rate_index(int coding_profile, int hoa_order, int bitrate, int nb_channels)
+{
+    if (coding_profile == CODING_PROFILE_HOA) {
+        if (hoa_order == 1) {
+            if (bitrate <= 128000) {
+                return BWE_CONFIG_HOA_LOW;
+            } else if (bitrate == 192000) {
+                return BWE_CONFIG_HOA_MIDDLE;
+            } else if (bitrate == 256000) {
+                return BWE_CONFIG_HOA_HIGH;
+            }
+        } else if (hoa_order == 2) {
+            if (bitrate == 192000) {
+                return BWE_CONFIG_HOA_EXTRA_LOW;
+            } else if (bitrate == 256000) {
+                return BWE_CONFIG_HOA_LOW;
+            } else if (bitrate == 320000) {
+                return BWE_CONFIG_HOA_MIDDLE;
+            } else if (bitrate >= 384000 && bitrate <= 480000) {
+                return BWE_CONFIG_HOA_HIGH;
+            }
+        } else if (hoa_order == 3) {
+            if (bitrate >= 256000 && bitrate <= 384000) {
+                return BWE_CONFIG_HOA_LOW;
+            } else if (bitrate == 512000) {
+                return BWE_CONFIG_HOA_MIDDLE;
+            } else if (bitrate >= 640000) {
+                return BWE_CONFIG_HOA_HIGH;
+            }
+        }
+    } else if (nb_channels == 1) {
+        if (bitrate <= 32000) {
+            return BWE_CONFIG_MONO_32K;
+        } else if (bitrate == 44000 || bitrate == 56000) {
+            return BWE_CONFIG_MONO_48K;
+        } else if (bitrate == 64000 || bitrate == 72000) {
+            return BWE_CONFIG_MONO_64K;
+        } else if (bitrate == 80000 || bitrate == 96000) {
+            return BWE_CONFIG_MONO_96K;
+        }
+    } else if (nb_channels == 2) {
+        if (bitrate <= 48000) {
+            return BWE_CONFIG_STEREO_48K;
+        } else if (bitrate <= 64000) {
+            return BWE_CONFIG_STEREO_64K;
+        } else if (bitrate <= 96000) {
+            return BWE_CONFIG_STEREO_96K;
+        } else if (bitrate <= 128000) {
+            return BWE_CONFIG_STEREO_128K;
+        }
+    } else {
+        int cpe_bitrate = bitrate * STEREO_CHANNELS / nb_channels;
+        if (cpe_bitrate <= 56000) {
+            return BWE_CONFIG_MC_CPE_48K;
+        } else if (cpe_bitrate <= 75000) {
+            return BWE_CONFIG_MC_CPE_64K;
+        } else if (cpe_bitrate <= 108000) {
+            return BWE_CONFIG_MC_CPE_96K;
+        } else if (cpe_bitrate <= 128000) {
+            return BWE_CONFIG_MC_CPE_128K;
+        }
+    }
+
+    return -1;
+}
+
+static int core_init(AVS3ACore *core, int ch_index, int coding_profile, int hoa_order,
+                     int bitrate, int nb_channels)
+{
+    vector_fzero(core->spectrum, FRAME_LEN);
+    vector_fzero(core->samples, FRAME_LEN);
+
+    core->lsf_lbr = bitrate / nb_channels <= 32000;
+
+    core->bwe_present = bwe_present(coding_profile, hoa_order, bitrate, nb_channels);
+    if (core->bwe_present) {
+        int index = bwe_rate_index(coding_profile, hoa_order, bitrate, nb_channels);
+        if (index < 0)
+            return AVERROR_INVALIDDATA;
+        core->bwe_config = &avs3a_bwe[index];
+    }
+
+    av_lfg_init(&core->lfg, ch_index);
+
+    return 0;
+}
