+static void stereo_bits_allocation(int available_bits, int bits_ratio, int *channel_bytes)
+{
+    int available_bytes = available_bits / 8;
+
+    channel_bytes[0] = bits_ratio * (available_bytes / (1 << 3));
+    channel_bytes[1] = available_bytes - channel_bytes[0];
+}
+
+static void ms_upmix(float *left, float *right, int start, int stop,
+                     float left_scale, float right_scale)
+{
+    float a = 0.5f * sqrt(2.0f);
+    left_scale  *= a;
+    right_scale *= a;
+    for (int i = start; i < stop; i++) {
+        float l = left[i];
+        float r = right[i];
+        left[i]  = left_scale  * (l + r);
+        right[i] = right_scale * (l - r);
+    }
+}
