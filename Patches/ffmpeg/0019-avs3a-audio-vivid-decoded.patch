+int ff_avs3a_parse_header(void *ctx, GetBitContext *gb, int *header_size,
+                          AVS3AHeader *s, int *sample_rate, uint16_t *crc)
+{
+    unsigned int bitrate_index;
+    unsigned int bitrate_index_per_channel;
+    int ret;
+
+    if (get_bits(gb, 12) != 0xfff)
+        return AVERROR_INVALIDDATA;;
+    if (get_bits(gb, 4) != 2)
+        return AVERROR_INVALIDDATA;;
+    if (get_bits1(gb) != 0)
+        return AVERROR_INVALIDDATA;;
+
+    s->nn_type = get_bits(gb, 3);
+    if (s->nn_type >= 2)
+        return AVERROR_INVALIDDATA;
+
+    s->coding_profile = get_bits(gb, 3);
+
+    *sample_rate = avs3a_sampling_rate[get_bits(gb, 4)];
+    if (!*sample_rate)
+        return AVERROR_INVALIDDATA;
+
+    *crc = get_bits(gb, 8) << 8;
+
+    if (s->coding_profile == CODING_PROFILE_BASIC) {
+        s->channel_number_index = get_bits(gb, 7);
+        s->nb_objects = 0;
+    } else if (s->coding_profile == CODING_PROFILE_OBJECT) {
+        s->sound_bed_type = get_bits(gb, 2);
+        if (s->sound_bed_type == 0) {
+            s->nb_objects = get_bits(gb, 7) + 1;
+            bitrate_index_per_channel = get_bits(gb, 4);
+        } else if (s->sound_bed_type == 1) {
+            s->channel_number_index = get_bits(gb, 7);
+            bitrate_index = get_bits(gb, 4);
+            s->nb_objects = get_bits(gb, 7) + 1;
+            bitrate_index_per_channel = get_bits(gb, 4);
+        } else
+            return AVERROR_INVALIDDATA;
+    } else if (s->coding_profile == CODING_PROFILE_HOA) {
+        s->hoa_order = get_bits(gb, 4) + 1;
+        s->nb_objects = 0;
+    } else
+        return AVERROR_INVALIDDATA;
+
+    skip_bits(gb, 2);
+
+    if (s->coding_profile != 1)
+        bitrate_index = get_bits(gb, 4);
+
+    *crc |= get_bits(gb, 8);
+    *header_size = align_get_bits(gb) - gb->buffer;
+
+    s->bed_bitrate = 0;
+
+    if (s->coding_profile == CODING_PROFILE_BASIC) {
+        AVChannelLayout tmp;
+        if ((ret = set_ch_layout(ctx, &tmp, s->channel_number_index)) < 0)
+            return ret;
+        s->lfe = tmp.nb_channels > 2 ? tmp.nb_channels != 4 : 0;
+        s->bitrate = avs3a_bitrate[s->channel_number_index][bitrate_index] * 1000;
+    } else if (s->coding_profile == CODING_PROFILE_OBJECT) {
+        if (s->sound_bed_type == 0) {
+            s->per_object_bitrate = avs3a_bitrate[0][bitrate_index_per_channel] * 1000;
+            if (!s->per_object_bitrate)
+                return AVERROR_INVALIDDATA;
+            s->bitrate = s->nb_objects * s->per_object_bitrate;
+            s->lfe = 0;
+        } else if (s->sound_bed_type == 1) {
+            AVChannelLayout tmp;
+            if ((ret = set_ch_layout(ctx, &tmp, s->channel_number_index)) < 0)
+                return ret;
+            s->bed_bitrate = avs3a_bitrate[s->channel_number_index][bitrate_index] * 1000;
+            s->per_object_bitrate = avs3a_bitrate[0][bitrate_index_per_channel] * 1000;
+            if (!s->bed_bitrate || !s->per_object_bitrate)
+                return AVERROR_INVALIDDATA;
+
+            s->lfe = tmp.nb_channels > 2 ? tmp.nb_channels != 4 : 0;
+            s->bitrate = s->bed_bitrate + s->nb_objects * s->per_object_bitrate;
+        }
+    } else if (s->coding_profile == CODING_PROFILE_HOA) {
+        if (s->hoa_order > 3)
+            return AVERROR_INVALIDDATA;
+        s->bitrate = avs3a_bitrate_ambisonic[s->hoa_order - 1][bitrate_index] * 1000;
+    }
+
+    if (!s->bitrate)
+        return AVERROR_INVALIDDATA;
+
+    s->bits_per_frame = (s->bitrate / (float)*sample_rate) * FRAME_LEN;
+
+    int bytes_per_frame = (s->bits_per_frame + 7) / 8;
+
+    return bytes_per_frame;
+}
+
+int ff_avs3a_get_ch_layout(void *ctx, const AVS3AHeader *s, AVChannelLayout *ch_layout)
+{
+    int ret;
+    if (s->coding_profile == CODING_PROFILE_BASIC) {
+        if ((ret = set_ch_layout(ctx, ch_layout, s->channel_number_index)) < 0)
+            return ret;
+    } else if (s->coding_profile == CODING_PROFILE_OBJECT) {
+        if (s->sound_bed_type == 0) {
+            ch_layout->nb_channels = s->nb_objects;
+        } else if (s->sound_bed_type == 1) {
+            AVChannelLayout tmp;
+            if ((ret = set_ch_layout(ctx, &tmp, s->channel_number_index)) < 0)
+                return ret;
+            if ((ret = av_channel_layout_custom_init(ch_layout,
+                           tmp.nb_channels + s->nb_objects)) < 0)
+                return ret;
+            for (int i = 0; i < tmp.nb_channels; i++)
+                ch_layout->u.map[i].id = av_channel_layout_channel_from_index(&tmp, i);
+        }
+    } else if (s->coding_profile == CODING_PROFILE_HOA) {
+        if (s->hoa_order == 1) {
+            *ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_AMBISONIC_FIRST_ORDER;
+        } else if (s->hoa_order <= 3) {
+            if ((ret = av_channel_layout_custom_init(ch_layout,
+                           (s->hoa_order + 1) * (s->hoa_order + 1))) < 0)
+                return ret;
+            for (int i = 0; i < ch_layout->nb_channels; i++)
+                ch_layout->u.map[i].id = AV_CHAN_AMBISONIC_BASE + i;
+        } else
+            return AVERROR_INVALIDDATA;
+    } else
+        return AVERROR_INVALIDDATA;
+
+    return 0;
+}
