+static void mc_upmix(AVS3ADecoder *s, AVS3AMC *mc)
+{
+    for (int i = 0; i < mc->nb_pairs; i++) {
+        const uint8_t *pair = mc->pair[i];
+#define GET_SCALE(idx) ((idx) < FF_ARRAY_ELEMS(avs3a_mc_ild_codebook) ? avs3a_mc_ild_codebook[idx] : 1.0f)
+        ms_upmix(mc->spectrum_ptr[pair[0]], mc->spectrum_ptr[pair[1]], 0, FRAME_LEN,
+                 GET_SCALE(mc->ild[pair[0]]), GET_SCALE(mc->ild[pair[1]]));
+    }
+}
+
+#define MC_BIT_RATIOS_DIV (1 << 6)
+#define MAX_FRAME_BYTES (256000 * FRAME_LEN / SAMPLING_RATE / 8)
+static int mc_bits_allocation(int total_bits, int lfe_bytes, const uint8_t *bit_ratios,
+                              int nb_channels, int *channel_bytes)
+{
+    uint8_t inuse[MAX_CHANNELS] = {0};
+    int nb_main_channels = nb_channels - !!lfe_bytes;
+    int total_bytes = total_bits / 8 - lfe_bytes;
+    int bytes_remaining = total_bytes - nb_main_channels * SILENCE_BYTES;
+    int bytes_allocated = 0;
+
+    int max_channel_bytes = 0;
+    int most_bits_ch = 0;
+    int ratio_sum = 0;
+    for (int i = 0; i < nb_main_channels; i++) {
+        channel_bytes[i] = bit_ratios[i] * bytes_remaining / MC_BIT_RATIOS_DIV + SILENCE_BYTES;
+        bytes_allocated += channel_bytes[i];
+
+        if (channel_bytes[i] > max_channel_bytes) {
+            max_channel_bytes = channel_bytes[i];
+            most_bits_ch = i;
+        }
+        ratio_sum += bit_ratios[i];
+    }
+    if (!ratio_sum)
+        return AVERROR_INVALIDDATA;
+
+    if (bytes_allocated != total_bytes) {
+        int diff = bytes_allocated - total_bytes;
+        bytes_allocated = 0;
+        for (int i = 0; i < nb_main_channels; i++) {
+            channel_bytes[i] -= diff * bit_ratios[i] / MC_BIT_RATIOS_DIV;
+            channel_bytes[i] = FFMAX(SILENCE_BYTES, channel_bytes[i]);
+            bytes_allocated += channel_bytes[i];
+        }
+    }
+
+    if (total_bytes != bytes_allocated)
+        channel_bytes[most_bits_ch] += total_bytes - bytes_allocated;
+
+    for (int j = 0; j < nb_main_channels; j++) {
+        int realloc_flag = 0;
+        for (int i = 0; i < nb_main_channels; i++) {
+            if (channel_bytes[i] > MAX_FRAME_BYTES && !inuse[i]) {
+                bytes_remaining = channel_bytes[i] - MAX_FRAME_BYTES;
+                channel_bytes[i] = MAX_FRAME_BYTES;
+                ratio_sum -= bit_ratios[i];
+                if (ratio_sum <= 0)
+                    return AVERROR_INVALIDDATA;
+
+                inuse[i] = 1;
+                realloc_flag = 1;
+                break;
+            }
+        }
+
+        if (!realloc_flag)
+            break;
+
+        bytes_allocated = 0;
+        for (int i = 0; i < nb_main_channels; i++) {
+            if (inuse[i])
+                continue;
+            int extra = bit_ratios[i] * bytes_remaining / ratio_sum;
+            bytes_allocated += extra;
+            channel_bytes[i] += extra;
+        }
+
+        if (bytes_allocated != bytes_remaining)
+            channel_bytes[most_bits_ch] += bytes_remaining - bytes_allocated;
+    }
+
+    if (lfe_bytes) {
+        for (int i = nb_channels - 1; i > LFE_CHANNEL_INDEX; i--)
+            channel_bytes[i] = channel_bytes[i - 1];
+
+        channel_bytes[LFE_CHANNEL_INDEX] = lfe_bytes;
+    }
+
+    return 0;
+}
+
+static int mc_bits_allocation_sil_flag(int total_bits, const uint8_t *bit_ratios,
+                                       int nb_channels, int *channel_bytes,
+                                       const uint8_t *sil_flag,
+                                       int lfe_bytes, int lfe_ch_index)
+{
+    int channel_bytes2[MAX_CHANNELS];
+    int ret;
+
+    int nb_not_silent = 0;
+    for (int i = 0; i < nb_channels; i++)
+        if (!sil_flag[i])
+            nb_not_silent++;
+
+    total_bits -= (nb_channels - nb_not_silent) * SILENCE_BYTES * 8;
+
+    if ((ret = mc_bits_allocation(total_bits, lfe_bytes, bit_ratios, nb_not_silent, channel_bytes2)) < 0)
+        return ret;
+
+    int j = 0;
+    for (int i = 0; i < nb_channels; i++) {
+        if (i == lfe_ch_index) {
+            channel_bytes[LFE_CHANNEL_INDEX] = lfe_bytes;
+        } else if (sil_flag[i]) {
+            channel_bytes[i] = SILENCE_BYTES;
+        } else {
+            if (j == lfe_ch_index)
+                j++;
+            channel_bytes[i] = channel_bytes2[j];
+            j++;
+        }
+    }
+
+    return 0;
+}
+
+static int get_lfe_bytes(int bitrate, int nb_coupled_channels)
+{
+    int cpe_bitrate = bitrate * 2 / nb_coupled_channels;
+    if (cpe_bitrate < 64000)
+        return 10; // 3.75 kbps
+    else if (cpe_bitrate < 96000)
+        return 15; // 5.625 kbps
+    else
+        return 20; // 7.5 kbps
+}
+
+static int calc_pair_index_bits(int nb_channels)
+{
+    return FFMAX(1, av_ceil_log2(nb_channels * (nb_channels - 1) / 2));
+}
+
+static int reset_decoder_mc(AVS3ADecoder *s)
+{
+    AVS3AMC *mc = &s->mc;
+    int nb_channels = s->avctx->ch_layout.nb_channels - s->header.nb_objects;
+    int i;
+
+    if (s->header.lfe) {
+        int nb_coupled_channels = nb_channels - 1;
+        if (!nb_coupled_channels)
+             return AVERROR_INVALIDDATA;
+        mc->lf_ch_index = LFE_CHANNEL_INDEX;
+        if (s->header.nb_objects && s->header.sound_bed_type == 1)
+            mc->lfe_bytes = get_lfe_bytes(s->header.bed_bitrate, nb_coupled_channels);
+        else
+            mc->lfe_bytes = get_lfe_bytes(s->header.bitrate, nb_coupled_channels);
+    } else {
+        mc->lf_ch_index = -1;
+        mc->lfe_bytes = 0;
+    }
+
+    mc->pair_index_bits = calc_pair_index_bits(s->avctx->ch_layout.nb_channels);
+
+    i = 0;
+    for (int ch = 0; ch < nb_channels; ch++)
+        if (ch != mc->lf_ch_index)
+            mc->spectrum_ptr[i++] = s->core[ch].spectrum;
+
+    if (s->header.lfe)
+        mc->spectrum_ptr[nb_channels - 1] = s->core[mc->lf_ch_index].spectrum;
+
+    for (int ch = nb_channels; ch < s->avctx->ch_layout.nb_channels; ch++)
+        mc->spectrum_ptr[ch] = s->core[ch].spectrum;
+
+    return 0;
+}
+
+static int hoa_bits_allocation(AVS3AHOA *hoa, int total_bits, int *channel_bytes)
+{
+    int total_bytes = total_bits / 8;
+    int used_bytes = total_bytes;
+    int group_bytes[MAX_HOA_GROUPS];
+    int validation_sum = 0;
+
+    for (int group = 0; group < hoa->config->nb_groups - 1; group++) {
+        group_bytes[group] = total_bytes * hoa->group_bits_ratio[group] / (1 << 4);
+        used_bytes -= group_bytes[group];
+    }
+    group_bytes[hoa->config->nb_groups - 1] = used_bytes;
+
+    for (int group = 0; group < hoa->config->nb_groups; group++) {
+        int nb_channels = hoa->config->nb_channels[group];
+        int offset = hoa->group_ch_offset[group];
+
+        int ratio_sum = 0;
+        for (int ch = 0; ch < nb_channels; ch++)
+            ratio_sum += hoa->bits_ratio[group][ch];
+        if (!ratio_sum)
+            return AVERROR_INVALIDDATA;
+
+        int per = group_bytes[group] / ratio_sum;
+        int rem = group_bytes[group] % ratio_sum;
+
+        for (int ch = 0; ch < nb_channels; ch++)
+            channel_bytes[ch + offset] = per * hoa->bits_ratio[group][ch];
+
+        if (rem >= nb_channels) {
+            int extra = rem / nb_channels;
+            for (int ch = 0; ch < nb_channels; ch++)
+                channel_bytes[ch + offset] += extra;
+
+            if (rem != nb_channels)
+                channel_bytes[0 + offset] += rem % nb_channels;
+        } else {
+            channel_bytes[0 + offset] += rem;
+        }
+
+        for (int ch = 0; ch < nb_channels; ch++)
+            validation_sum += channel_bytes[ch + offset];
+    }
+
+    av_assert0(validation_sum*8 + (total_bits % 8) == total_bits);
+
+    return 0;
+}
+
+static float qsin(int idx)
+{
+    if (idx <= 256)
+        return sin_table[idx];
+    else if (idx <= 512)
+        return sin_table[512 - idx];
+    else if (idx <= 768)
+        return -sin_table[idx - 512];
+    else
+        return -sin_table[1024 - idx];
+}
+
+static float qcos(int idx)
+{
+    if (idx <= 256)
+        return sin_table[256 - idx];
+    else if (idx <= 512)
+        return -sin_table[idx - 256];
+    else if (idx <= 768)
+        return -sin_table[768 - idx];
+    else
+        return sin_table[idx - 768];
+}
+
+static void calc_single_neighbor_basis_coeffs(const uint16_t angle[2], float *coeffs)
+{
+    uint16_t az = angle[0];
+    uint16_t el = angle[1];
+    float r00 = sqrt(1.0f / 4.0f / M_PI);
+    float r01 = sqrt(3.0f / 4.0f / M_PI);
+    float r04 = sqrt(5.0f / 16.0f / M_PI);
+    float r05 = sqrt(15.0f / 4.0f / M_PI);
+    float r07 = sqrt(15.0f / 16.0f / M_PI);
+    float r09 = sqrt(7.0f / 16.0f / M_PI);
+    float r10 = sqrt(21.0f / 32.0f / M_PI);
+    float r12 = sqrt(105.0f / 16.0f / M_PI);
+    float r14 = sqrt(35.0f / 32.0f / M_PI);
+    float saz = qsin(az);
+    float caz = qcos(az);
+    float sel = qsin(el);
+    float cel = qcos(el);
+    float saz2 = saz * saz;
+    float sel2 = sel * sel;
+    float caz2 = caz * caz;
+    float cel2 = cel * cel;
+    float scaz = saz * caz;
+    float t;
+
+    coeffs[0] = r00;
+    coeffs[2] = r01 * sel;
+    t = r01 * cel;
+    coeffs[1] = t * saz;
+    coeffs[3] = t * caz;
+    coeffs[6] = r04 * (3.0f * sel2 - 1.0f);
+    t = r05 * cel * sel;
+    coeffs[5] = t * saz;
+    coeffs[7] = t * caz;
+    t = r07 * cel2;
+    coeffs[4] = t * 2.0f * scaz;
+    coeffs[8] = t * (2.0f * caz2 - 1.0f);
+    coeffs[12] = r09 * (5.0f * sel2 * sel - 3.0f * sel);
+    t = r10 * cel * (5.0f * sel2 - 1.0f);
+    coeffs[11] = t * saz;
+    coeffs[13] = t * caz;
+    t = r12 * cel2 * sel;
+    coeffs[10] = t * 2.0f * scaz;
+    coeffs[14] = t * (2.0f * caz2 - 1.0f);
+    t = r14 * cel2 * cel;
+    coeffs[9] = t * (3.0f * saz - 4.0f * saz2 * saz);
+    coeffs[15] = t * (4.0f * caz2 * caz - 3.0f * caz);
+}
+
+static const HoaGroupConfig *find_group_config(const HoaGroupConfig *table,
+                                               int nb_entries, int bitrate)
+{
+    for (int i = 0; i < nb_entries; i++) {
+        const HoaGroupConfig *cfg = &table[i];
+        if (bitrate == cfg->bitrate_kbps * 1000)
+            return cfg;
+    }
+    return NULL;
+}
+
+static const HoaGroupConfig *hoa_get_bitrate_config(int hoa_order, int bitrate)
+{
+    switch (hoa_order) {
+    case 1: return &avs3a_foa_group_config[bitrate > 256000];
+    case 2: return find_group_config(avs3a_hoa_2_group_config,
+                                     FF_ARRAY_ELEMS(avs3a_hoa_2_group_config), bitrate);
+    case 3: return find_group_config(avs3a_hoa_3_group_config,
+                                     FF_ARRAY_ELEMS(avs3a_hoa_3_group_config), bitrate);
+    }
+    av_assert0(0);
+}
+
+static int reset_decoder_hoa(AVS3ADecoder *s)
+{
+    AVS3AHOA *hoa = &s->hoa;
+    int ret;
+
+    hoa->config = hoa_get_bitrate_config(s->header.hoa_order, s->header.bitrate);
+    if (!hoa->config)
+        return AVERROR_INVALIDDATA;
+
+    hoa->nb_transport_channels = 0;
+    for (int i = 0; i < hoa->config->nb_groups; i++)
+        hoa->nb_transport_channels += hoa->config->nb_channels[i];
+
+    hoa->group_ch_offset[0] = 0;
+    for (int i = 1; i < hoa->config->nb_groups; i++)
+        hoa->group_ch_offset[i] = hoa->group_ch_offset[i - 1] + hoa->config->nb_channels[i - 1];
+
+    for (int i = 0; i < hoa->config->nb_groups; i++)
+        hoa->pair_index_bits[i] = calc_pair_index_bits(hoa->config->nb_channels[i]);
+
+    for (int ch = 0; ch < s->avctx->ch_layout.nb_channels; ch++)
+        if ((ret = core_init(&s->core[ch], ch, s->header.coding_profile, s->header.hoa_order,
+                             s->header.bitrate, hoa->nb_transport_channels)) < 0)
+            return ret;
+
+    for (int ch = 0; ch < MAX_CHANNELS; ch++) {
+        vector_fzero(hoa->delay_buffer[ch], FRAME_LEN + FRAME_LEN);
+        vector_fzero(hoa->spectrum[ch], FRAME_LEN);
+        vector_fzero(hoa->synth_buffer[ch], HOA_OVERLAP_SIZE);
+        hoa->samples_ptr[ch] = hoa->delay_buffer[ch] + FRAME_LEN;
+    }
+
+    for (int group = 0; group < hoa->config->nb_groups; group++) {
+        int offset = hoa->group_ch_offset[group];
+        for (int ch = 0; ch < hoa->config->nb_channels[group]; ch++)
+            s->core[ch + offset].bwe_present = hoa->config->bwe_present[group];
+    }
+
+    for (int i = 0; i < HOA_DELAY_BASIS; i++)
+        memset(hoa->delay_basis_idx[i], 0, MAX_HOA_BASIS*sizeof(uint16_t));
+
+    return 0;
+}
+
+static void apply_relu(float *dst, const float *src, int len)
+{
+    for (int i = 0; i < len; i++)
+        dst[i] = FFMAX(0.0f, src[i]);
+}
+
+static void matrix_transpose_squared(float *mT, const float *m, int nb_rows, int nb_cols)
+{
+    for (int r = 0; r < nb_cols; r++)
+        for (int c = 0; c < nb_rows; c++) {
+            float v = m[c * nb_cols + r];
+            mT[r * nb_rows + c] = v * v;
+        }
+}
+
+static void apply_igdn(const CNNLayerConfig *config, CNNScratch *scratch,
+                       float *output, int nb_features_out)
+{
+    ConstMatrix a, b;
+    Matrix r;
+
+    matrix_transpose_squared(scratch->igdn.inputT, output,
+                             config->nb_channels_out, nb_features_out);
+
+    a.data = scratch->igdn.inputT;
+    a.nb_rows = nb_features_out;
+    a.nb_cols = config->nb_channels_out;
+    b.data = config->gamma;
+    b.nb_rows = config->nb_channels_out;
+    b.nb_cols = config->nb_channels_out;
+    r.data = scratch->igdn.output;
+    r.nb_rows = nb_features_out;
+    r.nb_cols = config->nb_channels_out;
+    matrix_mult(&r, &a, &b);
+
+    for (int i = 0; i < nb_features_out; i++)
+        for (int j = 0; j < config->nb_channels_out; j++)
+            output[j * nb_features_out + i] *=
+                sqrt(scratch->igdn.output[i * config->nb_channels_out + j] + config->beta[j]);
+}
+
+static void pad1(const float *input, float *output, int nb_features, int nb_channels)
+{
+    int nb_features_padded = nb_features + 2;
+
+    for (int j = 0; j < nb_channels; j++) {
+        output[j*nb_features_padded] = 0.0f;
+        for (int i = 0; i < nb_features; i++)
+            output[j*nb_features_padded + 1 + i] = input[j*nb_features + i];
+        output[j*nb_features_padded + 1 + nb_features] = 0.0f;
+    }
+}
+
+static void im2col1d(const float *input, float *output, int nb_features,
+                     int kernel_size, int nb_channels, int input_channel_stride)
+{
+    for (int j = 0; j < nb_channels; j++)
+        for (int k = 0; k < kernel_size; k++)
+            for (int i = 0; i < nb_features; i++)
+                output[(i * nb_channels + j) * kernel_size + k] =
+                    input[j * input_channel_stride + k + i];
+}
+
+static void add_bias(float *feature, const float *bias, int nb_features, int nb_channels)
+{
+    for (int j = 0; j < nb_channels; j++)
+        for (int i = 0; i < nb_features; i++)
+            feature[j * nb_features + i] += bias[j];
+}
+
+static void apply_activation_function(const CNNLayerConfig *config, CNNScratch *scratch,
+                                      float *output, int nb_features_out)
+{
+    switch (config->activation) {
+    case LINEAR: break;
+    case RELU: apply_relu(output, output, nb_features_out * config->nb_channels_out); break;
+    case IGDN: apply_igdn(config, scratch, output, nb_features_out); break;
+    }
+}
+
+static void convolution_stride1(const CNNLayerConfig *config, CNNScratch *scratch,
+                                const float *input, float *output, int nb_features_in)
+{
+    int nb_features_in_padded = nb_features_in + 2;
+    int nb_features_out = nb_features_in;
+    ConstMatrix a, b;
+    Matrix r;
+
+    pad1(input, scratch->input_padded, nb_features_in, config->nb_channels_in);
+
+    im2col1d(scratch->input_padded, scratch->u.stride1.input_col, nb_features_in,
+             config->kernel_size, config->nb_channels_in, nb_features_in_padded);
+
+    a.data = config->kernel_col;
+    a.nb_rows = config->nb_channels_out;
+    a.nb_cols = config->nb_channels_in * config->kernel_size;
+    b.data = scratch->u.stride1.input_col;
+    b.nb_rows = nb_features_in;
+    b.nb_cols = config->nb_channels_in * config->kernel_size;
+    r.data = output;
+    r.nb_rows = config->nb_channels_out;
+    r.nb_cols = nb_features_in;
+    matrix_mult(&r, &a, &b);
+
+    add_bias(output, config->bias, nb_features_out, config->nb_channels_out);
+    apply_activation_function(config, scratch, output, nb_features_out);
+}
+
+static void convolution_stride2(const CNNLayerConfig *config, CNNScratch *scratch,
+                                const float *input, float *output, int nb_features_in)
+{
+    int nb_features_in_padded = nb_features_in + 2;
+    int nb_features_out = nb_features_in * 2;
+    ConstMatrix a, b;
+    Matrix r;
+
+    pad1(input, scratch->input_padded, nb_features_in, config->nb_channels_in);
+
+    im2col1d(scratch->input_padded, scratch->u.stride2.input_col_odd, nb_features_in,
+             (config->kernel_size + 1) / 2, config->nb_channels_in, nb_features_in_padded);
+
+    if (config->kernel_size == 3)
+        im2col1d(input, scratch->u.stride2.input_col_even, nb_features_in,
+                 (config->kernel_size - 1) / 2, config->nb_channels_in, nb_features_in);
+    else // config->kernel_size == 5
+        im2col1d(scratch->input_padded, scratch->u.stride2.input_col_even, nb_features_in,
+                 (config->kernel_size - 1) / 2, config->nb_channels_in, nb_features_in_padded);
+
+    a.data = config->kernel_col_even;
+    a.nb_rows = config->nb_channels_out;
+    a.nb_cols = config->nb_channels_in * (config->kernel_size - 1) / 2;
+    b.data = scratch->u.stride2.input_col_even;
+    b.nb_rows = nb_features_in;
+    b.nb_cols = config->nb_channels_in * (config->kernel_size - 1) / 2;
+    r.data = scratch->u.stride2.output_tmp_even;
+    r.nb_rows = config->nb_channels_out;
+    r.nb_cols = nb_features_in;
+    matrix_mult(&r, &a, &b);
+
+    a.data = config->kernel_col_odd;
+    a.nb_rows = config->nb_channels_out;
+    a.nb_cols = config->nb_channels_in * (config->kernel_size + 1) / 2;
+    b.data = scratch->u.stride2.input_col_odd;
+    b.nb_rows = nb_features_in;
+    b.nb_cols = config->nb_channels_in * (config->kernel_size + 1) / 2;
+    r.data = scratch->u.stride2.output_tmp_odd;
+    r.nb_rows = config->nb_channels_out;
+    r.nb_cols = nb_features_in;
+    matrix_mult(&r, &a, &b);
+
+    if (config->kernel_size == 3) {
+        for (int i = 0; i < nb_features_in * config->nb_channels_out; i++) {
+            output[2 * i] = scratch->u.stride2.output_tmp_odd[i]; // odd first
+            output[2 * i + 1] = scratch->u.stride2.output_tmp_even[i];
+        }
+    } else { // config->kernel_size == 5
+        for (int i = 0; i < nb_features_in * config->nb_channels_out; i++) {
+            output[2 * i] = scratch->u.stride2.output_tmp_even[i]; // even first
+            output[2 * i + 1] = scratch->u.stride2.output_tmp_odd[i];
+        }
+    }
+
+    add_bias(output, config->bias, nb_features_out, config->nb_channels_out);
+    apply_activation_function(config, scratch, output, nb_features_out);
+}
+
+static void rc_get_byte(RangeDecoder *rc)
+{
+    rc->value <<= 8;
+    if (rc->nb_bytes) {
+        rc->value |= get_bits(rc->gb, 8);
+        rc->nb_bytes--;
+    }
+}
+
+static void rc_begin(RangeDecoder *rc, GetBitContext *gb, int nb_bytes)
+{
+    rc->base = 0;
+    rc->size_minus_one = UINT32_MAX;
+    rc->value = 0;
+    rc->gb = gb;
+    rc->nb_bytes = nb_bytes;
+    for (int i = 0; i < 4; i++)
+        rc_get_byte(rc);
+}
+
+static int partition_point(const uint32_t *cdf, int len, uint64_t size, uint64_t offset)
+{
+    int i = 1;
+    int end = len - 1;
+
+    while (i < end) {
+        int mid = i + ((end - i) >> 1);
+        if (size * (uint64_t)cdf[mid] <= offset)
+            i = mid + 1;
+        else
+            end = mid;
+    }
+
+    return i;
+}
+
+static void update_interval(RangeDecoder *rc, uint32_t lower, uint32_t upper)
+{
+    rc->base += lower;
+    rc->size_minus_one = upper - lower;
+
+    if (rc->size_minus_one >> 16 == 0) {
+        rc->base <<= 16;
+        rc->size_minus_one = (rc->size_minus_one << 16) | 0xffff;
+        rc_get_byte(rc);
+        rc_get_byte(rc);
+    }
+}
+
+static int rc_decode_symbol(RangeDecoder *rc, int precision, const uint32_t *cdf,
+                            int cdf_length)
+{
+    uint64_t size = (uint64_t)(rc->size_minus_one) + 1;
+    uint64_t offset = (((uint64_t)(rc->value - rc->base) + 1) << precision) - 1;
+    int k = partition_point(cdf, cdf_length, size, offset) - 1;
+
+    uint32_t lower = (size * (uint64_t)cdf[k]) >> precision;
+    uint32_t upper = ((size * (uint64_t)cdf[k + 1]) >> precision) - 1;
+    update_interval(rc, lower, upper);
+
+    return k;
+}
+
+static int rc_decode_symbol_uniform(RangeDecoder *rc, int precision)
+{
+    uint64_t size = (uint64_t)(rc->size_minus_one) + 1;
+    uint64_t offset = (((uint64_t)(rc->value - rc->base) + 1) << precision) - 1;
+    int k = offset / size;
+
+    uint32_t lower = (size * (uint64_t)k) >> precision;
+    uint32_t upper = ((size * (uint64_t)(k + 1)) >> precision) - 1;
+    update_interval(rc, lower, upper);
+
+    return k;
+}
+
+#define RC_OVERFLOW_BITS 4
+static int32_t decode_coeff(RangeDecoder *rc, const RangeDecoderConfig *config, int idx)
+{
+    int32_t max_value = config->cdf_length[idx] - 2;
+    uint32_t max_overflow = (1 << RC_OVERFLOW_BITS) - 1;
+
+    int32_t value = rc_decode_symbol(rc, 16, config->cdf[idx], config->cdf_length[idx]);
+    if (value == max_value) {
+        uint32_t overflow;
+
+        int nb_reads = 0;
+        do {
+            overflow = rc_decode_symbol_uniform(rc, RC_OVERFLOW_BITS);
+            nb_reads += overflow;
+        } while (overflow == max_overflow);
+
+        uint32_t value2 = 0;
+        int value2_too_big = 0;
+        for (int j = 0; j < nb_reads; ++j) {
+            overflow = rc_decode_symbol_uniform(rc, RC_OVERFLOW_BITS);
+            int shift = j * RC_OVERFLOW_BITS;
+            if (shift >= 28) {
+                value2_too_big = 1;
+                continue;
+            }
+            value2 |= overflow << shift;
+        }
+
+        if (value2_too_big)
+            return value;
+
+        value = value2 >> 1;
+        if (value2 & 1)
+            value = -value - 1;
+        else
+            value += max_value;
+    }
+
+    return value + config->offset[idx];
+}
+
+static void rc_decode_coeffs_context(GetBitContext *gb, int nb_bytes, float *coeffs,
+                                     int nb_features, int nb_channels)
+{
+    RangeDecoder rc;
+    rc_begin(&rc, gb, nb_bytes);
+
+    for (int i = 0; i < nb_features; i++)
+        for (int j = 0; j < nb_channels; j++)
+            coeffs[j * nb_features + i] = avs3a_context_coeff_median[j] +
+                                          decode_coeff(&rc, &avs3a_context_rc_config, j);
+}
+
+static int find_context_scale_index(float threshold)
+{
+    for (int index = 0; index < FF_ARRAY_ELEMS(avs3a_base_context_scale); index++)
+        if (avs3a_base_context_scale[index] >= threshold)
+            return index;
+
+    return FF_ARRAY_ELEMS(avs3a_base_context_scale) - 1;
+}
+
+static void rc_decode_coeffs_base(GetBitContext *gb, int nb_bytes,
+                                  const float *context_output, float *coeffs,
+                                  int nb_features, int nb_channels)
+{
+    RangeDecoder rc;
+    rc_begin(&rc, gb, nb_bytes);
+
+#define ZERO_IMPLAUSIBLE(x) ((x) >= -1048576 && (x) <= 1048576 ? (x) : 0)
+    for (int i = 0; i < nb_features; i++)
+        for (int j = 0; j < nb_channels; j++) {
+            int index = find_context_scale_index(context_output[j * nb_features + i]);
+            int32_t coeff = decode_coeff(&rc, &avs3a_base_rc_config, index);
+            coeffs[j * nb_features + i] = ZERO_IMPLAUSIBLE(coeff);
+        }
+}
+
+static int reset_decoder(AVS3ADecoder *s)
+{
+    int ret;
+
+    if (s->header.coding_profile == CODING_PROFILE_HOA) {
+        if ((ret = reset_decoder_hoa(s)) < 0)
+            return ret;
+    } else {
+        for (int ch = 0; ch < s->avctx->ch_layout.nb_channels; ch++)
+            if ((ret = core_init(&s->core[ch], ch, s->header.coding_profile, 0,
+                                 s->header.bitrate,
+                                 s->avctx->ch_layout.nb_channels - s->header.lfe)) < 0)
+                return ret;
+        if (s->avctx->ch_layout.nb_channels == 2)
+            reset_decoder_stereo(s);
+        else if (s->avctx->ch_layout.nb_channels > 2)
+            if ((ret = reset_decoder_mc(s)) < 0)
+                return ret;
+    }
+
+    return 0;
+}
+
+static void copy_mcr_theta_vector(float *vector, const float (*codebook)[3], int idx)
+{
+    vector_fcopy(vector, codebook[idx], 3);
+}
+
+static int decode_stereo_side_bits(AVS3ADecoder *s)
+{
+    GetBitContext *gb = s->gb;
+    AVS3AStereo *stereo = &s->stereo;
+
+    if (!stereo->mcr) {
+        stereo->is_ms = get_bits1(gb);
+        if (stereo->is_ms) {
+            stereo->ild = get_bits(gb, 4);
+            if (!stereo->ild)
+                return AVERROR_INVALIDDATA;
+        }
+        stereo->bits_ratio = get_bits(gb, 3);
+    } else {
+        int is_short = s->core[0].transform_type == ONLY_SHORT_WINDOW;
+        int nb_bits = avs3a_mcr_theta_nb_bits[is_short];
+        const float (*codebook)[3] = avs3a_mcr_theta_codebook[is_short];
+
+        for (int i = 0; i < 6; i++) {
+            copy_mcr_theta_vector(&stereo->theta[0][i * 3], codebook, get_bits(gb, nb_bits));
+            copy_mcr_theta_vector(&stereo->theta[1][i * 3], codebook, get_bits(gb, nb_bits));
+        }
+    }
+
+    return 0;
+}
+
+static int decode_mc_side_bits(AVS3AMC *mc, GetBitContext *gb, int nb_channels,
+                               uint8_t *bit_ratios)
+{
+    if (get_bits1(gb))
+        for (int i = 0; i < nb_channels; i++)
+            mc->sil_flag[i] = i != mc->lf_ch_index ? get_bits1(gb) : 0;
+    else
+        memset(mc->sil_flag, 0, nb_channels);
+
+    mc->nb_pairs = get_bits(gb, 4);
+    if (mc->nb_pairs > FF_ARRAY_ELEMS(mc->pair))
+        return AVERROR_INVALIDDATA;
+
+    for (int i = 0; i < mc->nb_pairs; i++) {
+        uint8_t *pair = mc->pair[i];
+        if (find_mc_pair(pair, get_bits(gb, mc->pair_index_bits), nb_channels) < 0)
+            return AVERROR_INVALIDDATA;
+        mc->ild[pair[0]] = get_bits(gb, 5);
+        mc->ild[pair[1]] = get_bits(gb, 5);
+        if (mc->ild[pair[0]] > FF_ARRAY_ELEMS(avs3a_mc_ild_codebook) ||
+            mc->ild[pair[1]] > FF_ARRAY_ELEMS(avs3a_mc_ild_codebook))
+            return AVERROR_INVALIDDATA;
+    }
+
+    int j = 0;
+    for (int i = 0; i < nb_channels; i++)
+        if (i != mc->lf_ch_index && !mc->sil_flag[i])
+            bit_ratios[j++] = get_bits(gb, 6);
+
+    return 0;
+}
+
+static int decode_hoa_side_bits(AVS3AHOA *hoa, GetBitContext *gb)
+{
+    skip_bits(gb, 4);
+    hoa->spatial_analysis = get_bits1(gb);
+    if (hoa->spatial_analysis) {
+        hoa->nb_virtuals = get_bits(gb, 4);
+        if (!hoa->nb_virtuals || hoa->nb_virtuals > MAX_HOA_BASIS)
+            return AVERROR_INVALIDDATA;
+    } else
+        hoa->nb_virtuals = 0;
+
+    for (int i = 0; i < hoa->nb_virtuals; i++) {
+        hoa->basis_idx[i] = get_bits(gb, 12);
+        if (hoa->basis_idx[i] >= FF_ARRAY_ELEMS(avs3a_preset_virtual_speaker))
+            return AVERROR_INVALIDDATA;
+    }
+
+    for (int group = 0; group < hoa->config->nb_groups; group++) {
+        int nb_channels = hoa->config->nb_channels[group];
+        int group_ch_offset = hoa->group_ch_offset[group];
+        hoa->nb_pairs[group] = get_bits(gb, 4);
+        if (hoa->nb_pairs[group] > FF_ARRAY_ELEMS(hoa->pair_index[group]))
+            return AVERROR_INVALIDDATA;
+        if (hoa->nb_pairs[group]) {
+            for (int i = 0; i < hoa->nb_pairs[group]; i++) {
+                hoa->pair_index[group][i] = get_bits(gb, hoa->pair_index_bits[group]);
+                if (get_bits1(gb)) {
+                    for (int sfb = 0; sfb < FF_ARRAY_ELEMS(avs3a_hoa_sfb_lbr) - 1; sfb++)
+                        hoa->sfb_mask[group][i][sfb] = get_bits1(gb);
+                } else
+                    memset(hoa->sfb_mask[group][i], 1,
+                           FF_ARRAY_ELEMS(avs3a_hoa_sfb_lbr) - 1);
+            }
+
+            for (int i = 0; i < nb_channels; i++) {
+                hoa->ild[group_ch_offset + i] = get_bits(gb, 5);
+                if (hoa->ild[group_ch_offset + i] > FF_ARRAY_ELEMS(avs3a_mc_ild_codebook))
+                    return AVERROR_INVALIDDATA;
+            }
+        } else {
+            memset(hoa->ild + group_ch_offset, FF_ARRAY_ELEMS(avs3a_mc_ild_codebook),
+                   nb_channels);
+        }
+
+        hoa->group_bits_ratio[group] = get_bits(gb, 4);
+        for (int i = 0; i < nb_channels; i++)
+            hoa->bits_ratio[group][i] = get_bits(gb, 4);
+    }
+
+    return 0;
+}
+
+static int decode_core_side_bits(AVS3ACore *core, GetBitContext *gb)
+{
+    core->transform_type = get_bits(gb, 2);
+
+    for (int i = 0; i < (core->lsf_lbr ? 5 : 7); i++)
+        core->lsf_vq_index[i] = get_bits(gb, avs3a_lsf_vq_index_nb_bits[i]);
+
+    for (int i = 0; i < MAX_NB_TNS_FILTER; i++) {
+        TNSParam *tns = &core->tns_param[i];
+        tns->enable = get_bits1(gb);
+        if (tns->enable) {
+            tns->order = get_bits(gb, 3) + 1;
+            if (tns->order > MAX_TNS_FILTER_ORDER)
+                return AVERROR_INVALIDDATA;
+            for (int j = 0; j < tns->order; j++) {
+                int index = get_vlc2(gb, tns_coeff_vlc[j], 9, 2);
+                if (index < 0)
+                    return AVERROR_INVALIDDATA;
+                tns->parcor_coeffs[j] = parcor4[index];
+            }
+        }
+    }
+
+    if (core->bwe_present) {
+        for (int i = 0; i < core->bwe_config->nb_sfb; i++)
+            core->sfb_envelope_index[i] = get_bits(gb, 7);
+
+        for (int i = 0; i < core->bwe_config->nb_tiles; i++)
+            if (get_bits1(gb))
+                core->whitening_level[i] = get_bits1(gb) ? BWE_WHITENING_HIGH
+                                                         : BWE_WHITENING_MID;
+            else
+                core->whitening_level[i] = BWE_WHITENING_OFF;
+    }
+
+    return 0;
+}
+
+static void decode_group_bits(AVS3ACore *core, GetBitContext *gb)
+{
+    if (core->transform_type == ONLY_SHORT_WINDOW) {
+        core->nb_mdct_groups = get_bits1(gb) + 1;
+        if (core->nb_mdct_groups == N_GROUP_SHORT_WIN) {
+            for (int j = 0; j < N_BLOCK_SHORT; j++)
+                core->group_indicator[j] = get_bits1(gb);
+        } else {
+            memset(core->group_indicator, 0, N_BLOCK_SHORT);
+        }
+    } else {
+        core->nb_mdct_groups = 1;
+        memset(core->group_indicator, 0, N_BLOCK_SHORT);
+    }
+}
+
+static void eq_effect(GetBitContext *gb)
+{
+    skip_bits(gb, 3);
+    skip_bits(gb, 7);
+    skip_bits1(gb);
+    skip_bits(gb, 6);
+    skip_bits(gb, 7);
+}
+
+static void audio_effect(GetBitContext *gb)
+{
+    int b_eq_exist = get_bits1(gb);
+    int b_drc_exist = get_bits1(gb);
+    int b_gain_exist = get_bits1(gb);
+
+    if (b_eq_exist || b_drc_exist || b_gain_exist)
+        skip_bits(gb, 3); //effectChain
+
+    if (b_eq_exist) {
+        int num_eq_band = get_bits(gb, 4) + 1;
+        for (int i = 0; i < num_eq_band; i++)
+            eq_effect(gb);
+    }
+
+    if (b_drc_exist) {
+        skip_bits(gb, 4); //attackTime
+        skip_bits(gb, 4); //releaseTime
+        skip_bits(gb, 7); //threshold
+        skip_bits(gb, 7); //preGain
+        skip_bits(gb, 7); //postGain
+        skip_bits(gb, 7); //ratio
+    }
+
+    if (b_gain_exist)
+        skip_bits(gb, 7); //effectGain
+}
+
+static void vertex(GetBitContext *gb)
+{
+    skip_bits(gb, 7); //x
+    skip_bits(gb, 7); //y
+    skip_bits(gb, 7); //z
+}
+
+static void surface(GetBitContext *gb, int nb_surface)
+{
+    int material = get_bits(gb, 5);
+    if (material == 0x1f) {
+        for (int i = 0; i < 8; i++) {
+            skip_bits(gb, 7); //absorption
+            skip_bits(gb, 7); //scattering
+        }
+    }
+
+    int nb_vertices = get_bits(gb, 5) + 1;
+    int num_vertices_limit = FFMIN(FFMAX(nb_vertices, (int16_t)ceil(8.0f / nb_surface)),
+                                         (int16_t)floor(36.0f / nb_surface));
+    for (int i = 0; i < num_vertices_limit; i++)
+        vertex(gb);
+}
+
+static void render_info(GetBitContext *gb)
+{
+    skip_bits1(gb); //targetDevice
+    skip_bits(gb, 4); //hrtfType
+
+    for (int i = 0; i < 16; i++)
+        skip_bits(gb, 7); //headphoneType
+
+    audio_effect(gb);
+}
+
+static void acoustic_env(GetBitContext *gb)
+{
+    int b_early_reflection_gain = get_bits1(gb);
+    int b_late_reverb_gain = get_bits1(gb);
+    int reverb_type = get_bits(gb, 2);
+
+    if (b_early_reflection_gain)
+        skip_bits(gb, 7); //earlyReflectionGain
+
+    if (b_late_reverb_gain)
+        skip_bits(gb, 7); //lateReverbGain
+
+    skip_bits1(gb); //lowFreqProFlag
+
+    if (reverb_type == 2)
+        skip_bits(gb, 5); //convolutionReverbType
+
+    int nb_surface = get_bits(gb, 3) + 1;
+    for (int i = 0; i < nb_surface; i++)
+        surface(gb, nb_surface);
+}
+
+static void vr_ext_l1(GetBitContext *gb)
+{
+    int b_acoustic_env = get_bits1(gb);
+    int b_render_info = get_bits1(gb);
+    skip_bits(gb, 3); //ambisonicOrder
+    if (b_acoustic_env)
+        acoustic_env(gb);
+    if (b_render_info)
+        render_info(gb);
+}
+
+static void direct_speakers_position(GetBitContext *gb)
+{
+    skip_bits(gb, 8); //azimuth
+    skip_bits(gb, 6); //elevation
+    skip_bits(gb, 4); //distance
+    skip_bits(gb, 2); //DirectSpeakerScreenEdgeLock
+}
+
+static void dialogue(AVS3ADecoder *s, GetBitContext *gb)
+{
+    int dialogue_attribute = get_bits(gb, 2);
+    int dialogue_type = get_bits(gb, 3);
+    switch (dialogue_attribute) {
+    case 0: /* non-dialogue */
+        switch (dialogue_type) {
+        case 1: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_KARAOKE; break;
+        case 2: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_EFFECTS; break;
+        }
+        break;
+    case 1: /* dialogue */
+        switch (dialogue_type) {
+        case 1: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_DIALOGUE; break;
+        case 2: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_VOICE_OVER; break;
+        case 3: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_DIALOGUE; break; /* spoken subtitle */
+        case 4: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_VISUALLY_IMPAIRED; break;
+        case 5: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_COMMENTARY; break;
+        case 6: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_EMERGENCY; break;
+        }
+        break;
+    case 2: /* mixed-content */
+        switch (dialogue_type) {
+        case 1: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_MAIN; break;
+        case 2: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_MAIN; break; /* mixed */
+        case 3: s->avctx->audio_service_type = AV_AUDIO_SERVICE_TYPE_HEARING_IMPAIRED; break;
+        }
+        break;
+    }
+}
+
+static void audio_object_interaction(GetBitContext *gb)
+{
+    skip_bits1(gb); //onOffInteract
+    int gain_interact = get_bits1(gb);
+    int position_interact = get_bits1(gb);
+
+    if (gain_interact) {
+        skip_bits1(gb); //gainInteractionUnit
+        skip_bits(gb, 7); //gainInteractionRange_min
+        skip_bits(gb, 7); //gainInteractionRange_max
+    }
+
+    if (position_interact) {
+        if (get_bits1(gb)) {
+            skip_bits(gb, 8); //positionInteractionRange_Xmin
+            skip_bits(gb, 8); //positionInteractionRange_Xmax
+            skip_bits(gb, 6); //positionInteractionRange_Ymin
+            skip_bits(gb, 6); //positionInteractionRange_Ymax
+            skip_bits(gb, 4); //positionInteractionRange_Zmin
+            skip_bits(gb, 4); //positionInteractionRange_Zmax
+        } else {
+            skip_bits(gb, 8); //positionInteractionRange_azimuthMin
+            skip_bits(gb, 8); //positionInteractionRange_azimuthMax
+            skip_bits(gb, 6); //positionInteractionRange_elevationMin
+            skip_bits(gb, 6); //positionInteractionRange_elevationMax
+            skip_bits(gb, 4); //positionInteractionRange_distanceMin
+            skip_bits(gb, 4); //positionInteractionRange_distanceMax
+        }
+    }
+}
+
+static void audio_programme_reference_screen(GetBitContext *gb)
+{
+    int cartesian_reference_screen = get_bits1(gb);
+    skip_bits(gb, 3); //aspectRatio
+
+    if (!cartesian_reference_screen) {
+        skip_bits(gb, 8); //screenCentrePosition_azimuth
+        skip_bits(gb, 6); //screenCentrePosition_elevation
+        skip_bits(gb, 4); //screenCentrePosition_distance
+        skip_bits(gb, 7); //screenWidth_polar
+    } else {
+        skip_bits(gb, 8); //screenCentrePosition_X
+        skip_bits(gb, 6); //screenCentrePosition_Y
+        skip_bits(gb, 4); //screenCentrePosition_Z
+        skip_bits(gb, 7); //screenWidth_cartesian
+    }
+}
+
+static void loudness_metadata(GetBitContext *gb)
+{
+    int b_integrated_loudness = get_bits1(gb);
+    int b_loudness_range = get_bits1(gb);
+    int b_max_true_peak = get_bits1(gb);
+    int b_max_momentary = get_bits1(gb);
+    int b_max_short_term = get_bits1(gb);
+    int b_dialogue_loudness = get_bits1(gb);
+
+    if (b_integrated_loudness)
+        skip_bits(gb, 5); //integratedLoudness
+
+    if (b_loudness_range)
+        skip_bits(gb, 5); //loudnessRange
+
+    if (b_max_true_peak)
+        skip_bits(gb, 5); //maxTruePeak
+
+    if (b_max_momentary)
+        skip_bits(gb, 5); //maxMomentary
+
+    if (b_max_short_term)
+        skip_bits(gb, 5); //maxShortTerm
+
+    if (b_dialogue_loudness)
+        skip_bits(gb, 5); //dialogueLoudness
+}
+
+typedef struct {
+    int valid;
+    int type_label;
+    int pack_format_id;
+    int num_matrix_output_channel;
+} Pack;
+
+static void audio_channel_format(GetBitContext *gb, const Pack *pack)
+{
+    int idx = get_bits(gb, 5);
+
+    if (get_bits1(gb)) {
+        skip_bits1(gb); //channelGainUnit
+        skip_bits1(gb); //channelGain_QFlag
+        skip_bits(gb, 6); //channelGain
+    }
+
+    if (pack[idx].valid) {
+        if (pack[idx].type_label == 1)
+            if (pack[idx].pack_format_id == 0x3f)
+                direct_speakers_position(gb);
+
+        if (pack[idx].type_label == 2)
+            for (int i = 0; i < pack[idx].num_matrix_output_channel; i++)
+                skip_bits(gb, 8); //matrixCoef
+    }
+}
+
+static void audio_pack_format(GetBitContext *gb, Pack *pack)
+{
+    int pack_format_id;
+    int num_matrix_output_channel;
+
+    skip_bits(gb, 3); //packFormatIdx
+    int b_importance = get_bits1(gb);
+    int b_trans_channel_reuse = get_bits1(gb);
+
+    if (b_importance)
+        skip_bits(gb, 4); //audioPackFormatImportance
+
+    int type_label = get_bits(gb, 3);
+    skip_bits(gb, 5); //absoluteDistance
+
+    if (type_label == 1 || type_label == 2) {
+        pack_format_id = get_bits(gb, 6);
+        if (type_label == 2) {
+            num_matrix_output_channel = get_bits(gb, 5) + 1;
+            for (int i = 0; i < num_matrix_output_channel; i++)
+                direct_speakers_position(gb);
+        }
+    } else if (type_label == 4) {
+        skip_bits(gb, 2); //normalization
+        skip_bits(gb, 4); //nfcRefDist
+        skip_bits1(gb); //screenRef
+        skip_bits(gb, 3); //hoaOrder
+    }
+
+    if (!b_trans_channel_reuse)
+        skip_bits(gb, 5); //packFormatStartIdx
+
+    int nb_channels = get_bits(gb, 5) + 1;
+    for (int i = 0; i < nb_channels; i++) {
+        int idx = get_bits(gb, 5);
+
+        pack[idx].valid = 1;
+        pack[idx].type_label = type_label;
+
+        if (type_label == 1 || type_label == 2)
+            pack[idx].pack_format_id = pack_format_id;
+        if (type_label == 2)
+            pack[idx].num_matrix_output_channel = num_matrix_output_channel;
+
+        if (b_trans_channel_reuse)
+            skip_bits(gb, 5); //transChRef
+    }
+}
+
+static void audio_object(AVS3ADecoder *s, GetBitContext *gb)
+{
+    skip_bits(gb, 3); //objectIdx
+    int b_language = get_bits1(gb);
+    int b_dialogue = get_bits1(gb);
+    int b_importance = get_bits1(gb);
+    skip_bits1(gb); //b_disableDucking
+    int b_interact = get_bits1(gb);
+    int b_gain = get_bits1(gb);
+    skip_bits1(gb); //b_headLocked
+    skip_bits1(gb); //b_mute
+
+    if (b_language)
+        skip_bits(gb, 4); //audioObjectLanguage
+
+    if (b_dialogue)
+        dialogue(s, gb);
+
+    if (b_importance)
+        skip_bits(gb, 4); //audioObjectImportance
+
+    if (b_interact) {
+        for (int i = 0; i < 24; i++)
+            skip_bits(gb, 8); //ObjectName
+
+        audio_object_interaction(gb);
+    }
+
+    if (b_gain) {
+        skip_bits1(gb); //objectGainUnit
+        skip_bits1(gb); //objectGainQFlag
+        skip_bits(gb, 6); //objectGain
+    }
+
+    int nb_packs = get_bits(gb, 3) + 1;
+    for (int i = 0; i < nb_packs; i++)
+        skip_bits(gb, 3); //refPackFormatIdx
+}
+
+static void audio_content(AVS3ADecoder *s, GetBitContext *gb)
+{
+    skip_bits(gb, 2); //contentIdx
+    int b_audio_content_language = get_bits1(gb);
+    int b_loudness_metadata = get_bits1(gb);
+    int b_dialogue = get_bits1(gb);
+    int b_num_complementary_object_group = get_bits1(gb);
+
+    if (b_audio_content_language)
+        skip_bits(gb, 4); //audioContentLanguage
+
+    if (b_loudness_metadata)
+        loudness_metadata(gb);
+
+    if (b_dialogue)
+        dialogue(s, gb);
+
+    if (b_num_complementary_object_group) {
+        int num_complementary_object_group = get_bits(gb, 2) + 1;
+
+        for (int i = 0; i < num_complementary_object_group; i++) {
+            int num_complementary_object = get_bits(gb, 3) + 1;
+            for (int j = 0; j < num_complementary_object; j++)
+                skip_bits(gb, 3); //ComplementaryObjectIdx
+        }
+    }
+
+    int nb_objects = get_bits(gb, 3) + 1;
+    for (int i = 0; i < nb_objects; i++)
+        skip_bits(gb, 3); //refObjectIdx
+}
+
+static void audio_programme(GetBitContext *gb)
+{
+    int b_audio_programme_language = get_bits1(gb);
+    int b_max_ducking_depth = get_bits1(gb);
+    int b_loudness_metadata = get_bits1(gb);
+    int b_audio_programme_reference_screen = get_bits1(gb);
+
+    if (b_audio_programme_language)
+        skip_bits(gb, 4); //audioProgrammeLanguage
+
+    if (b_max_ducking_depth)
+        skip_bits(gb, 5); //maxDuckingDepth
+
+    if (b_loudness_metadata)
+        loudness_metadata(gb);
+
+    if (b_audio_programme_reference_screen)
+        audio_programme_reference_screen(gb);
+
+    int nb_contents = get_bits(gb, 2) + 1;
+    for (int i = 0; i < nb_contents; i++)
+        skip_bits(gb, 2); //refContentIdx
+}
+
+static void basic_l1(AVS3ADecoder *s, GetBitContext *gb)
+{
+    Pack pack[32] = {0};
+
+    audio_programme(gb);
+
+    int nb_contents = get_bits(gb, 2) + 1;
+    for (int i = 0; i < nb_contents; i++)
+        audio_content(s, gb);
+
+    int nb_objects = get_bits(gb, 3) + 1;
+    for (int i = 0; i < nb_objects; i++)
+        audio_object(s, gb);
+
+    int nb_packs = get_bits(gb, 3) + 1;
+    for (int i = 0; i < nb_packs; i++)
+        audio_pack_format(gb, pack);
+
+    int nb_channels = get_bits(gb, 5) + 1;
+    for (int i = 0; i < nb_channels; i++)
+        audio_channel_format(gb, pack);
+}
+
+static void static_metadata(AVS3ADecoder *s, GetBitContext *gb)
+{
+    int b_vrext = get_bits1(gb);
+    int basic_level = get_bits(gb, 3);
+
+    if (basic_level == 0 || basic_level == 1)
+        basic_l1(s, gb);
+
+    if (b_vrext) {
+        int vrext_level = get_bits(gb, 3);
+        if (vrext_level == 0)
+            vr_ext_l1(gb);
+    }
+}
+
+static void dynamic_metadata_l1(GetBitContext *gb, int mute_flag)
+{
+    if (!mute_flag) {
+        int cartesian = get_bits1(gb);
+        int b_obj_extent = get_bits1(gb);
+        int b_obj_gain = get_bits1(gb);
+        int b_obj_diffuse = get_bits1(gb);
+        int b_obj_importance = get_bits1(gb);
+
+        if (!cartesian) {
+            skip_bits(gb, 8); //obj_position_azimuth
+            skip_bits(gb, 6); //obj_position_elevation
+            skip_bits(gb, 4); //obj_position_distance
+            if (b_obj_extent) {
+                skip_bits(gb, 7); //obj_width_horizontal
+                skip_bits(gb, 5); //obj_height_vertical
+                skip_bits(gb, 4); //obj_depth_distance
+            }
+        } else {
+            skip_bits(gb, 8); //obj_position_x
+            skip_bits(gb, 6); //obj_position_y
+            skip_bits(gb, 4); //obj_position_z
+            if (b_obj_extent) {
+                skip_bits(gb, 7); //obj_width_x
+                skip_bits(gb, 5); //obj_hight_y
+                skip_bits(gb, 4); //obj_depth_z
+            }
+        }
+
+        if (b_obj_gain)
+            skip_bits(gb, 7); //gain
+
+        if (b_obj_diffuse)
+            skip_bits(gb, 7); //diffuse
+
+        skip_bits1(gb); //jumpPosition
+
+        if (b_obj_importance)
+            skip_bits(gb, 4); //importance
+    }
+}
+
+static void dynamic_metadata_l2(GetBitContext *gb, int mute_flag)
+{
+    if (!mute_flag) {
+        if (get_bits1(gb))
+            if (get_bits1(gb))
+                skip_bits(gb, 4); //channelLock_maxDistance
+
+        if (get_bits1(gb)) {
+            if (get_bits(gb, 4)) //objectDivergence
+                skip_bits(gb, 6); //objectDivergence_azimuthRange
+        }
+
+        if (get_bits1(gb))
+            skip_bits1(gb); //obj_screenRef
+
+        if (get_bits1(gb))
+            skip_bits(gb, 2); //screenEdgeLock
+    }
+}
+
+static void dynamic_metadata(GetBitContext *gb, int nb_objects)
+{
+    int level = get_bits(gb, 3);
+
+    for (int i = 0; i < nb_objects; i++) {
+        int mute_flag = get_bits1(gb);
+        skip_bits(gb, 5); //transChRef
+        if (level == 0) {
+            dynamic_metadata_l1(gb, mute_flag);
+        } else if (level == 1) {
+            dynamic_metadata_l1(gb, mute_flag);
+            dynamic_metadata_l2(gb, mute_flag);
+        }
+    }
+}
+
+static void parse_metadata(AVS3ADecoder *s)
+{
+    GetBitContext *gb = s->gb;
+
+    if (get_bits1(gb))
+        static_metadata(s, gb);
+
+    if (get_bits1(gb))
+        dynamic_metadata(gb, s->header.nb_objects);
+}
+
+static float rand_float(AVLFG *lfg, float min, float max)
+{
+    return min + (max-min) / UINT_MAX * av_lfg_get(lfg);
+}
+
+static void latent_noise_filling(AVLFG *lfg,
+                                 float *coeffs, int nb_features, int nb_channels,
+                                 int nb_nf,
+                                 int nb_mdct_groups, const uint8_t *group_indicator,
+                                 const float *nf_param)
+{
+    int start[N_GROUP_SHORT_WIN], stop[N_GROUP_SHORT_WIN];
+
+    if (nb_mdct_groups == 1) {
+        start[0] = 0;
+        start[1] = 0;
+        stop[0] = nb_nf;
+        stop[1] = nb_nf;
+    } else {
+        int nb_transient = count_nb_transient_blocks(group_indicator);
+
+        start[0] = 0;
+        stop[0] = nb_nf / (float)N_BLOCK_SHORT * nb_transient;
+
+        start[1] = nb_features / N_BLOCK_SHORT * nb_transient;
+        stop[1] = start[1] + nb_nf / (float)N_BLOCK_SHORT * (N_BLOCK_SHORT - nb_transient);
+    }
+
+    for (int group = 0; group < nb_mdct_groups; group++)
+        for (int i = start[group]; i < stop[group]; i++)
+            for (int j = 0; j < nb_channels; j++)
+                if (coeffs[j * nb_features + i] == 0.0f)
+                    coeffs[j * nb_features + i] = nf_param[group] * rand_float(lfg, -1.0f, 1.0f);
+}
+
+static void model_run(const ModelConfig *model_config, CNNScratch *scratch,
+                      float *input, float *output)
+{
+    int nb_features_out_prev_layer;
+
+    for (int i = 0; i < model_config->nb_layers; i++) {
+        const CNNLayerConfig *config = &model_config->layers[i];
+        float *layer_input = !i ? input : scratch->output;
+        float *layer_output = i < model_config->nb_layers - 1 ? scratch->output : output;
+        int nb_features_in = !i ? model_config->nb_features_in : nb_features_out_prev_layer;
+
+        if (config->stride == 1)
+            convolution_stride1(config, scratch, layer_input, layer_output, nb_features_in);
+        else
+            convolution_stride2(config, scratch, layer_input, layer_output, nb_features_in);
+
+        nb_features_out_prev_layer = nb_features_in * config->stride;
+    }
+}
+
+static int decode_qc(AVS3ADecoder *s, AVS3ACore *core)
+{
+    LOCAL_ALIGNED_32(float, coeffs, [FRAME_LEN]);
+    CNNScratch *scratch = &core->scratch;
+
+    // decode context bitstream
+
+    rc_decode_coeffs_context(&core->gb, core->context_bytes, coeffs,
+                             avs3a_context_model_config.nb_features_in,
+                             avs3a_context_model_config.layers[0].nb_channels_in);
+    model_run(&avs3a_context_model_config, scratch, coeffs, scratch->output);
+
+    // decode base bitstream
+
+    int base_nb_features_in = avs3a_base_model_config.nb_features_in;
+    int base_nb_channels_in = avs3a_base_model_config.layers[0].nb_channels_in;
+
+    rc_decode_coeffs_base(&core->gb, core->base_bytes, scratch->output, coeffs,
+                          base_nb_features_in, base_nb_channels_in);
+
+    int nb_nf = (core->bwe_present ? core->bwe_config->target_tile[0] : FRAME_LEN) / 16;
+    latent_noise_filling(&core->lfg, coeffs, base_nb_features_in, base_nb_channels_in,
+                         nb_nf, core->nb_mdct_groups, core->group_indicator,
+                         core->nf_param);
+
+    s->fdsp->vector_fmul_scalar(coeffs, coeffs, 1.0f / core->feature_scale,
+                                base_nb_features_in * base_nb_channels_in);
+
+    if (s->header.nn_type == NN_TYPE_BASIC) {
+        model_run(&avs3a_base_model_config, scratch, coeffs, core->spectrum);
+    } else { // NN_TYPE_LOW_COMPLEXITY
+        for (int i = 0; i < base_nb_features_in; i++)
+            for (int j = 0; j < base_nb_channels_in; j++)
+                core->spectrum[i * base_nb_channels_in + j] =
+                    coeffs[j * base_nb_features_in + i];
+    }
+
+    if (core->transform_type == ONLY_SHORT_WINDOW) {
+        float tmp[FRAME_LEN];
+        spectrum_degrouping(tmp, core->spectrum, core->group_indicator);
+        interleave_spectrum(core->spectrum, tmp);
+    }
+
+    return 0;
+}
+
+static int decode_qc_channel(AVCodecContext *avctx, void *tdata, int ch, int threadnr)
+{
+    AVS3ADecoder *s = avctx->priv_data;
+    decode_qc(s, &s->core[ch]);
+    return 0;
+}
+
+static int inverse_qc(AVS3ADecoder *s, const int *channel_bytes, int nb_channels)
+{
+    GetBitContext *gb = s->gb;
+
+    for (int ch = 0; ch < nb_channels; ch++) {
+        AVS3ACore *core = &s->core[ch];
+        if (s->header.nn_type == NN_TYPE_BASIC) {
+            if (get_bits1(gb))
+                core->feature_scale = pow(10.0f, get_bits(gb, 7) / 86.0f);
+            else
+                core->feature_scale = get_bits(gb, 7) / 127.0f;
+        } else // NN_TYPE_LOW_COMPLEXITY
+            core->feature_scale = pow(10.0f, (get_bits(gb, 8) - 255.0f) / 31.875f);
+
+        if (core->feature_scale == 0.0f)
+            core->feature_scale = 1.0f;
+
+        for (int i = 0; i < core->nb_mdct_groups; i++)
+            core->nf_param[i] = get_bits(gb, 3) / 23.34f;
+
+        core->context_bytes = get_bits(gb, 8);
+        if (core->context_bytes > channel_bytes[ch])
+            return AVERROR_INVALIDDATA;
+        core->base_bytes = channel_bytes[ch] - core->context_bytes;
+        core->gb = *gb;
+        skip_bits_long(gb, channel_bytes[ch] * 8);
+    }
+
+    s->avctx->execute2(s->avctx, decode_qc_channel, NULL, NULL, nb_channels);
+    return 0;
+}
+
+static void inverse_mdct(AVS3ADecoder *s, AVS3ACore *core, float *output)
+{
+    LOCAL_ALIGNED_32(float, win_left, [FRAME_LEN]);
+    LOCAL_ALIGNED_32(float, win_right, [FRAME_LEN]);
+
+    window_shape(core, win_left, win_right);
+
+    if (core->transform_type != ONLY_SHORT_WINDOW) {
+        LOCAL_ALIGNED_32(float, signal, [FRAME_LEN + FRAME_LEN]);
+
+        s->imdct_fn(s->imdct_ctx, signal, core->spectrum, sizeof(float));
+
+        window_signal(s, core->transform_type, signal, signal, win_left, win_right);
+
+        vector_fadd(signal, core->samples, signal, FRAME_LEN);
+
+        s->fdsp->vector_fmul_scalar(output, signal, 1.0f / 32768.0f, FRAME_LEN);
+
+        vector_fcopy(core->samples, signal + FRAME_LEN, FRAME_LEN);
+    } else {
+        float tmp[BLOCK_LEN_SHORT];
+        LOCAL_ALIGNED_32(float, signal, [BLOCK_LEN_SHORT + BLOCK_LEN_SHORT]);
+        LOCAL_ALIGNED_32(float, tmp_samples, [FRAME_LEN]);
+
+        vector_fcopy(tmp, core->samples + BLOCK_PADDING_SIZE, BLOCK_LEN_SHORT);
+
+        for (int i = 0; i < N_BLOCK_SHORT; i++) {
+            s->imdct_short_fn(s->imdct_short_ctx, signal,
+                              core->spectrum + i * BLOCK_LEN_SHORT, sizeof(float));
+
+            s->fdsp->vector_fmul(signal, signal, win_left, BLOCK_LEN_SHORT);
+            s->fdsp->vector_fmul(signal + BLOCK_LEN_SHORT, signal + BLOCK_LEN_SHORT,
+                                 win_right, BLOCK_LEN_SHORT);
+
+            vector_fadd(signal, tmp, signal, BLOCK_LEN_SHORT);
+
+            vector_fcopy(tmp, signal + BLOCK_LEN_SHORT, BLOCK_LEN_SHORT);
+
+            vector_fcopy(tmp_samples + i * BLOCK_LEN_SHORT, signal, BLOCK_LEN_SHORT);
+        }
+
+        s->fdsp->vector_fmul_scalar(output, core->samples, 1.0f / 32768.0f,
+                                    BLOCK_PADDING_SIZE);
+        s->fdsp->vector_fmul_scalar(output + BLOCK_PADDING_SIZE, tmp_samples, 1.0f / 32768.0f,
+                                    FRAME_LEN - BLOCK_PADDING_SIZE);
+
+        vector_fcopy(core->samples, tmp_samples + FRAME_LEN - BLOCK_PADDING_SIZE,
+                     BLOCK_PADDING_SIZE);
+        vector_fcopy(core->samples + BLOCK_PADDING_SIZE, tmp,
+                     BLOCK_LEN_SHORT);
+        vector_fzero(core->samples + BLOCK_PADDING_SIZE + BLOCK_LEN_SHORT,
+                     FRAME_LEN - BLOCK_PADDING_SIZE - BLOCK_LEN_SHORT);
+    }
+}
+
+static void lsf2lsp(const float *lsf, float *lsp)
+{
+    for (int i = 0; i < LPC_ORDER; i++)
+        lsp[i] = cos(lsf[i] * (float)M_PI / (SAMPLING_RATE / 2));
+}
+
+/* float version of libavcodec/lsp.c lsp2polyf() */
+static void lsp2polyf_float(const float *lsp, float *f, int lp_half_order)
+{
+    f[0] = 1.0;
+    f[1] = -2 * lsp[0];
+    lsp -= 2;
+    for (int i = 2; i <= lp_half_order; i++) {
+        float val = -2 * lsp[2*i];
+        f[i] = val * f[i-1] + 2*f[i-2];
+        for (int j = i-1; j > 1; j--)
+            f[j] += f[j-1] * val + f[j-2];
+        f[1] += val;
+    }
+}
+
+static void lsp2lpc(const float *lsp, float *lpc)
+{
+    int lp_half_order = LPC_ORDER / 2;
+#undef MAX_LP_HALF_ORDER
+#define MAX_LP_HALF_ORDER (LPC_ORDER / 2)
+    float pa[MAX_LP_HALF_ORDER + 1], qa[MAX_LP_HALF_ORDER + 1];
+    float *lpc2 = lpc + (lp_half_order << 1) - 1;
+
+    lsp2polyf_float(lsp, pa, lp_half_order);
+    lsp2polyf_float(lsp + 1, qa, lp_half_order);
+
+    lpc[0] = 1.0;
+    while (lp_half_order--) {
+        float paf = pa[lp_half_order + 1] + pa[lp_half_order];
+        float qaf = qa[lp_half_order + 1] - qa[lp_half_order];
+
+        lpc [ lp_half_order + 1] = 0.5f*(paf+qaf);
+        lpc2[-lp_half_order + 1] = 0.5f*(paf-qaf);
+    }
+}
+
+static void calculate_lpc_gain(AVS3ADecoder *s, const float *lpc, float *lpc_gain)
+{
+    LOCAL_ALIGNED_32(AVComplexFloat, input, [FFT_TABLE_SIZE]);
+    LOCAL_ALIGNED_32(AVComplexFloat, output, [FFT_TABLE_SIZE]);
+    float raw_gain[FFT_TABLE_SIZE / 2 + 1];
+    float interpolated_gain[FRAME_LEN];
+
+    float weighting = 1.0f;
+    for (int i = 0; i < LPC_ORDER + 1; i++) {
+        float weighted_lpc = weighting * lpc[i];
+        float angle = i * (float)M_PI / (float)FFT_TABLE_SIZE;
+        input[i].re =  weighted_lpc * cos(angle);
+        input[i].im = -weighted_lpc * sin(angle);
+        weighting *= 0.939999998f;
+    }
+
+    memset(input + LPC_ORDER + 1, 0, (FFT_TABLE_SIZE - LPC_ORDER - 1)*sizeof(AVComplexFloat));
+
+    s->fft_fn(s->fft_ctx, output, input, sizeof(AVComplexFloat));
+
+    for (int i = 0; i < FFT_TABLE_SIZE / 2 + 1; i++)
+        raw_gain[i] = 1.0f / sqrt(output[i].re * output[i].re + output[i].im * output[i].im);
+
+    for (int i = 0; i < FFT_TABLE_SIZE / 2; i++) {
+#define INTERPOLATION (FRAME_LEN / (FFT_TABLE_SIZE / 2))
+        float step = (raw_gain[i + 1] - raw_gain[i]) / INTERPOLATION;
+        interpolated_gain[i*INTERPOLATION    ] = raw_gain[i];
+        interpolated_gain[i*INTERPOLATION + 1] = raw_gain[i] + step;
+        interpolated_gain[i*INTERPOLATION + 2] = raw_gain[i] + 2.0f * step;
+        interpolated_gain[i*INTERPOLATION + 3] = raw_gain[i] + 3.0f * step;
+    }
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(avs3a_sfb_borders) - 1; i++) {
+        int start = avs3a_sfb_borders[i];
+        int stop = avs3a_sfb_borders[i + 1];
+        float avg = 0.0f;
+        for (int j = start; j < stop; j++)
+            avg += interpolated_gain[j];
+        avg /= (float)(stop - start);
+        for (int j = start; j < stop; j++)
+            lpc_gain[j] = avg;
+    }
+}
+
+static void set_max_dist_lsf(float *lsf, float min_spacing)
+{
+    float prev = SAMPLING_RATE / 2;
+    for (int i = LPC_ORDER - 1; i >= 0; i--)
+        prev = lsf[i] = FFMIN(lsf[i], prev - min_spacing);
+}
+
+static void lsf_dequant_hbr(const uint8_t *idx, float *lsf)
+{
+    vector_fcopy(lsf, avs3a_lsf_stage1_cb1_hbr[idx[0]], 9);
+    vector_fcopy(lsf + 9, avs3a_lsf_stage1_cb2_hbr[idx[1]], 7);
+
+    for (int i = 0; i < 3; i++)
+        lsf[i] += avs3a_lsf_stage2_cb1_hbr[idx[2]][i];
+    for (int i = 0; i < 3; i++)
+        lsf[3 + i] += avs3a_lsf_stage2_cb2_hbr[idx[3]][i];
+    for (int i = 0; i < 3; i++)
+        lsf[6 + i] += avs3a_lsf_stage2_cb3_hbr[idx[4]][i];
+    for (int i = 0; i < 3; i++)
+        lsf[9 + i] += avs3a_lsf_stage2_cb4_hbr[idx[5]][i];
+    for (int i = 0; i < 4; i++)
+        lsf[12 + i] += avs3a_lsf_stage2_cb5_hbr[idx[6]][i];
+}
+
+static void lsf_dequant_lbr(const uint8_t *idx, float *lsf)
+{
+    vector_fcopy(lsf, avs3a_lsf_stage1_cb1_lbr[idx[0]], 9);
+    vector_fcopy(lsf + 9, avs3a_lsf_stage1_cb2_lbr[idx[1]], 7);
+
+    for (int i = 0; i < 5; i++)
+        lsf[i] += avs3a_lsf_stage2_cb1_lbr[idx[2]][i];
+    for (int i = 0; i < 4; i++)
+        lsf[5 + i] += avs3a_lsf_stage2_cb2_lbr[idx[3]][i];
+    for (int i = 0; i < 7; i++)
+        lsf[9 + i] += avs3a_lsf_stage2_cb3_lbr[idx[4]][i];
+}
+
+static void spectrum_shaping(AVS3ADecoder *s, const uint8_t *lsf_vq_idx,
+                             float *spectrum, int lsf_lbr)
+{
+    float lsf[LPC_ORDER];
+    float lsp[LPC_ORDER];
+    float lpc[LPC_ORDER + 1];
+    LOCAL_ALIGNED_32(float, lpc_gain, [FRAME_LEN]);
+
+    if (!lsf_lbr)
+        lsf_dequant_hbr(lsf_vq_idx, lsf);
+    else
+        lsf_dequant_lbr(lsf_vq_idx, lsf);
+
+    for (int i = 0; i < LPC_ORDER; i++)
+        lsf[i] += avs3a_mean_lsf[i];
+
+    ff_set_min_dist_lsf(lsf, LSF_MIN_GAP, LPC_ORDER);
+    set_max_dist_lsf(lsf, LSF_MIN_GAP);
+
+    lsf2lsp(lsf, lsp);
+
+    lsp2lpc(lsp, lpc);
+
+    calculate_lpc_gain(s, lpc, lpc_gain);
+
+    s->fdsp->vector_fmul(spectrum, spectrum, lpc_gain, FRAME_LEN);
+}
+
+static float iir_filter(int order, const float *coeff, float *state, float v)
+{
+    v -= coeff[order - 1] * state[order - 1];
+    for (int i = order - 2; i >= 0; i--) {
+        v -= coeff[i] * state[i];
+        state[i + 1] = coeff[i] * v + state[i];
+    }
+
+    state[0] = v;
+    return v;
+}
+
+static void inverse_tns(TNSParam *tns_param, float *spectrum)
+{
+    float state[MAX_TNS_FILTER_ORDER] = {0.0f};
+
+    for (int i = MAX_NB_TNS_FILTER - 1; i >= 0; i--) {
+        if (!tns_param[i].enable)
+            continue;
+        int start = avs3a_tns_filter[i];
+        int width = avs3a_tns_filter[i + 1] - start;
+        for (int j = 0; j < width; j++)
+            spectrum[start + j] = iir_filter(tns_param[i].order, tns_param[i].parcor_coeffs,
+                                             state, spectrum[start + j]);
+    }
+}
+
+static void bwe_copy_tiles(AVS3ACore *core, const float *input, float *output)
+{
+    int first_tile = core->bwe_config->target_tile[0];
+    vector_fcopy(output, input, first_tile);
+
+    for (int i = 0; i < core->bwe_config->nb_tiles; i++) {
+        int start = core->bwe_config->target_tile[i];
+        int width = core->bwe_config->target_tile[i + 1] - start;
+        vector_fcopy(output + start, input + core->bwe_config->source_tile[i], width);
+    }
+
+    int last_tile = core->bwe_config->target_tile[core->bwe_config->nb_tiles];
+    vector_fzero(output + last_tile, FRAME_LEN - last_tile);
+}
+
+static void bwe_whitening_mid(const float *input, float *output, int start, int stop)
+{
+#define LEN_WHITEN_AVERAGE 7
+    for (int i = start; i < stop; i++) {
+        const float *start = input - LEN_WHITEN_AVERAGE + i;
+        float avg = sqrt(ff_scalarproduct_float_c(start, start, 2*LEN_WHITEN_AVERAGE + 1) /
+                         (float)(2*LEN_WHITEN_AVERAGE + 1));
+        output[i] = avg == 0.0f ? input[i] : (input[i] / avg);
+    }
+}
+
+static void bwe_whitening_high(AVLFG *lfg, const float *input, float *output,
+                               int start, int stop)
+{
+    float sum = 0.0f;
+    for (int i = start; i < stop; i++)
+        sum += fabs(input[i]);
+
+    if (sum > 0.0f) {
+        for (int i = start; i < stop; i++)
+            output[i] = rand_float(lfg, -1.0f, 1.0f);
+    } else {
+        vector_fzero(output + start, stop - start);
+    }
+}
+
+static void bwe_whitening(AVLFG *lfg, AVS3ACore *core, const float *input, float *output)
+{
+    vector_fzero(output, FRAME_LEN);
+
+    for (int i = 0; i < core->bwe_config->nb_tiles; i++) {
+        int start = core->bwe_config->target_tile[i];
+        int stop = core->bwe_config->target_tile[i + 1];
+
+        switch (core->whitening_level[i]) {
+        case BWE_WHITENING_OFF: vector_fcopy(output + start, input + start, stop - start); break;
+        case BWE_WHITENING_MID: bwe_whitening_mid(input, output, start, stop); break;
+        case BWE_WHITENING_HIGH: bwe_whitening_high(lfg, input, output, start, stop); break;
+        }
+    }
+}
+
+static void bwe_envelope(AVS3ACore *core, const float *input, float *output)
+{
+    const uint16_t *sfb = core->bwe_config->sfb;
+    float current_energy, target_energy, gain;
+
+    for (int i = 0; i < core->bwe_config->nb_sfb; i++) {
+        int start = sfb[i];
+        int stop = sfb[i + 1];
+        int width = stop - start;
+
+        current_energy = ff_scalarproduct_float_c(input + start, input + start, width) / width;
+
+        target_energy = pow(2.0f, core->sfb_envelope_index[i] / 4.24966f - 4.0f);
+        gain = fabs(current_energy) > 0.0f ? sqrt(target_energy / current_energy) : 1.0f;
+
+        for (int j = start; j < stop; j++)
+            output[j] = gain * input[j];
+    }
+
+    int stop_line = core->bwe_config->target_tile[core->bwe_config->nb_tiles];
+    vector_fzero(output + stop_line, FRAME_LEN - stop_line);
+}
+
+static void post_synthesis(AVS3ADecoder *s, AVS3ACore *core, float *output, int is_lfe)
+{
+    if (core->bwe_present) {
+        float tmp1[FRAME_LEN], tmp2[FRAME_LEN];
+        bwe_copy_tiles(core, core->spectrum, tmp1);
+        bwe_whitening(&core->lfg, core, tmp1, tmp2);
+        bwe_envelope(core, tmp2, core->spectrum);
+    }
+
+    if (core->transform_type == ONLY_SHORT_WINDOW) {
+        float tmp[FRAME_LEN];
+        deinterleave_spectrum(tmp, core->spectrum);
+        inverse_tns(core->tns_param, tmp);
+        interleave_spectrum(core->spectrum, tmp);
+    } else
+        inverse_tns(core->tns_param, core->spectrum);
+
+    spectrum_shaping(s, core->lsf_vq_index, core->spectrum, core->lsf_lbr);
+
+    if (is_lfe)
+        vector_fzero(core->spectrum + 32, FRAME_LEN - 32); // 32=750 Hz
+
+    if (core->transform_type == ONLY_SHORT_WINDOW) {
+        float tmp[FRAME_LEN];
+        deinterleave_spectrum(tmp, core->spectrum);
+        vector_fcopy(core->spectrum, tmp, FRAME_LEN);
+    }
+
+    inverse_mdct(s, core, output);
+}
+
+static int find_group_pair(uint8_t *pair, int target_index, int nb_channels)
+{
+    int index = 0;
+    for (int j = 1; j < nb_channels; j++) {
+        for (int i = 0; i < j; i++) {
+            if (index == target_index) {
+                pair[0] = i;
+                pair[1] = j;
+                return 0;
+            }
+            index++;
+        }
+    }
+
+    return -1;
+}
+
+static int hoa_upmix(AVS3ADecoder *s)
+{
+    const AVS3AHOA *hoa = &s->hoa;
+
+    for (int group = 0; group < hoa->config->nb_groups; group++) {
+        for (int i = 0; i < hoa->nb_pairs[group]; i++) {
+            uint8_t pair[2];
+            if (find_group_pair(pair, hoa->pair_index[group][i],hoa->config->nb_channels[group]) < 0)
+                return AVERROR_INVALIDDATA;
+            pair[0] += hoa->group_ch_offset[group];
+            pair[1] += hoa->group_ch_offset[group];
+            for (int sfb = 0; sfb < FF_ARRAY_ELEMS(avs3a_hoa_sfb_lbr) - 1; sfb++) {
+                if (hoa->sfb_mask[group][i][sfb])
+                    ms_upmix(s->core[pair[0]].spectrum, s->core[pair[1]].spectrum,
+                             avs3a_hoa_sfb_lbr[sfb], avs3a_hoa_sfb_lbr[sfb + 1],
+                             1.0f, 1.0f);
+            }
+        }
+    }
+
+    for (int ch = 0; ch < hoa->nb_transport_channels; ch++)
+        if (hoa->ild[ch] != FF_ARRAY_ELEMS(avs3a_mc_ild_codebook))
+            s->fdsp->vector_fmul_scalar(s->core[ch].spectrum, s->core[ch].spectrum,
+                                        avs3a_mc_ild_codebook[hoa->ild[ch]],
+                                        FRAME_LEN);
+
+    return 0;
+}
+
+static void spatial_decoding(AVS3AHOA *hoa, int nb_channels)
+{
+    float m[L_HOA_BASIS_ROWS][MAX_HOA_BASIS];
+    float recovery_signal[MAX_CHANNELS][FRAME_LEN];
+
+    for (int i = 0; i < hoa->nb_virtuals; i++) {
+        float tmp[L_HOA_BASIS_ROWS];
+        int idx = hoa->delay_basis_idx[0][i];
+        calc_single_neighbor_basis_coeffs(avs3a_preset_virtual_speaker[idx], tmp);
+
+        for (int ch = 0; ch < nb_channels; ch++)
+            m[ch][i] = tmp[ch];
+    }
+
+    for (int i = 0; i < FRAME_LEN; i++) {
+        float a[L_HOA_BASIS_ROWS], b[L_HOA_BASIS_ROWS];
+
+        for (int j = 0; j < hoa->nb_virtuals; j++)
+            a[j] = hoa->spectrum[j][i];
+
+        for (int ch = 0; ch < nb_channels; ch++) {
+            for (int j = 0; j < hoa->nb_virtuals; j++)
+                b[j] = m[ch][j];
+
+            recovery_signal[ch][i] = ff_scalarproduct_float_c(a, b, hoa->nb_virtuals);
+        }
+    }
+
+    for (int ch = 0; ch < hoa->nb_transport_channels - hoa->config->nb_channels[0]; ch++)
+        for (int i = 0; i < FRAME_LEN; i++)
+            recovery_signal[ch][i] += hoa->spectrum[hoa->nb_virtuals + ch][i];
+
+    for (int ch = 0; ch < nb_channels; ch++)
+        vector_fcopy(hoa->spectrum[ch], recovery_signal[ch], FRAME_LEN);
+}
+
+static void hoa_post_synthesis_filter(AVS3ADecoder *s, AVFrame *frame)
+{
+    AVS3AHOA *hoa = &s->hoa;
+    LOCAL_ALIGNED_32(float, samples, [FRAME_LEN]);
+
+    for (int ch = 0; ch < hoa->nb_transport_channels; ch++) {
+        for (int i = 0; i < N_BLOCK_HOA; i++) {
+            const float *input = hoa->samples_ptr[ch] + (i - 1)*HOA_OVERLAP_SIZE;
+            s->fdsp->vector_fmul(samples, input, hoa_window, HOA_OVERLAP_SIZE);
+            s->fdsp->vector_fmul_reverse(samples + HOA_OVERLAP_SIZE,
+                                         input + HOA_OVERLAP_SIZE,
+                                         hoa_window, HOA_OVERLAP_SIZE);
+
+            s->hoa_mdct_fn(s->hoa_mdct_ctx, hoa->spectrum[ch] + i * HOA_OVERLAP_SIZE,
+                           samples, sizeof(float));
+        }
+    }
+
+    if (hoa->spatial_analysis)
+        spatial_decoding(hoa, s->avctx->ch_layout.nb_channels);
+
+    for (int ch = 0; ch < s->avctx->ch_layout.nb_channels; ch++) {
+        float tmp[HOA_OVERLAP_SIZE];
+
+        vector_fcopy(tmp, hoa->synth_buffer[ch], HOA_OVERLAP_SIZE);
+
+        for (int i = 0; i < N_BLOCK_HOA; i++) {
+            s->hoa_imdct_fn(s->hoa_imdct_ctx, samples,
+                            hoa->spectrum[ch] + i * HOA_OVERLAP_SIZE, sizeof(float));
+
+            s->fdsp->vector_fmul(samples, samples, hoa_window, HOA_OVERLAP_SIZE);
+            s->fdsp->vector_fmul_reverse(samples + HOA_OVERLAP_SIZE, samples + HOA_OVERLAP_SIZE,
+                                         hoa_window, HOA_OVERLAP_SIZE);
+
+            vector_fadd(samples, tmp, samples, HOA_OVERLAP_SIZE);
+
+            vector_fcopy(tmp, samples + HOA_OVERLAP_SIZE, HOA_OVERLAP_SIZE);
+
+            vector_fcopy((float *)frame->extended_data[ch] + i * HOA_OVERLAP_SIZE,
+                         samples, HOA_OVERLAP_SIZE);
+        }
+
+        vector_fcopy(hoa->synth_buffer[ch], tmp, HOA_OVERLAP_SIZE);
+    }
+
+    for (int i = 0; i < HOA_DELAY_BASIS - 1; i++)
+        memcpy(hoa->delay_basis_idx[i], hoa->delay_basis_idx[i + 1],
+            hoa->nb_virtuals*sizeof(uint16_t));
+
+    memcpy(hoa->delay_basis_idx[HOA_DELAY_BASIS - 1], hoa->basis_idx,
+        hoa->nb_virtuals*sizeof(uint16_t));
+}
+
+static int decode_hoa(AVS3ADecoder *s, AVFrame *frame)
+{
+    GetBitContext *gb = s->gb;
+    int nb_channels = s->hoa.nb_transport_channels;
+    uint8_t nb_mdct_groups[MAX_CHANNELS];
+    int channel_bytes[MAX_CHANNELS];
+    int ret;
+
+    for (int ch = 0; ch < nb_channels; ch++)
+        if ((ret = decode_core_side_bits(&s->core[ch], gb)) < 0)
+            return ret;
+
+    for (int ch = 0; ch < nb_channels; ch++) {
+        decode_group_bits(&s->core[ch], gb);
+        nb_mdct_groups[ch] = s->core[ch].nb_mdct_groups;
+    }
+
+    if ((ret = decode_hoa_side_bits(&s->hoa, gb)) < 0)
+        return ret;
+
+    int available_bits = calc_available_bits(s, nb_mdct_groups, nb_channels);
+    if ((ret = hoa_bits_allocation(&s->hoa, available_bits, channel_bytes)) < 0 ||
+        (ret = inverse_qc(s, channel_bytes, nb_channels)) < 0 ||
+        (ret = hoa_upmix(s)) < 0)
+        return ret;
+
+    for (int ch = 0; ch < nb_channels; ch++)
+        post_synthesis(s, &s->core[ch], s->hoa.samples_ptr[ch], 0);
+
+    hoa_post_synthesis_filter(s, frame);
+
+    for (int ch = 0; ch < s->avctx->ch_layout.nb_channels; ch++)
+        vector_fcopy(s->hoa.delay_buffer[ch], s->hoa.delay_buffer[ch] + FRAME_LEN,
+                     FRAME_LEN);
+
+    return 0;
+}
+
+static int decode_mono(AVS3ADecoder *s, AVFrame *frame)
+{
+    GetBitContext *gb = s->gb;
+    AVS3ACore *core = &s->core[0];
+    int ret;
+
+    if ((ret = decode_core_side_bits(core, gb)) < 0)
+        return ret;
+
+    decode_group_bits(core, gb);
+
+    uint8_t nb_mdct_groups[1] = { core->nb_mdct_groups };
+    int channel_bytes[1] = { calc_available_bits(s, nb_mdct_groups, 1) / 8 };
+
+    if ((ret = inverse_qc(s, channel_bytes, 1)) < 0)
+        return ret;
+
+    post_synthesis(s, core, (float *)frame->extended_data[0], 0);
+
+    return 0;
+}
+
+static int decode_stereo(AVS3ADecoder *s, AVFrame *frame)
+{
+    GetBitContext *gb = s->gb;
+    uint8_t nb_mdct_groups[STEREO_CHANNELS];
+    int channel_bytes[STEREO_CHANNELS];
+    int ret;
+
+    for (int i = 0; i < STEREO_CHANNELS; i++)
+        if ((ret = decode_core_side_bits(&s->core[i], gb)) < 0)
+            return ret;
+
+    for (int i = 0; i < STEREO_CHANNELS; i++) {
+        decode_group_bits(&s->core[i], gb);
+        nb_mdct_groups[i] = s->core[i].nb_mdct_groups;
+    }
+
+    if ((ret = decode_stereo_side_bits(s)) < 0)
+        return ret;
+
+    int available_bits = calc_available_bits(s, nb_mdct_groups, STEREO_CHANNELS);
+    stereo_bits_allocation(available_bits, s->stereo.bits_ratio, channel_bytes);
+
+    if ((ret = inverse_qc(s, channel_bytes, STEREO_CHANNELS)) <  0)
+        return ret;
+
+    if (s->stereo.is_ms) {
+        float level_ratio = (float)(1 << 4) / s->stereo.ild - 1;
+        float left_scale = level_ratio < 1.0f ? 1.0f / level_ratio : 1.0f;
+        float right_scale = level_ratio > 1.0f ? level_ratio : 1.0f;
+        ms_upmix(s->core[0].spectrum, s->core[1].spectrum, 0, FRAME_LEN,
+                 left_scale, right_scale);
+    }
+
+    for (int i = 0; i < STEREO_CHANNELS; i++)
+        post_synthesis(s, &s->core[i], (float *)frame->extended_data[i], 0);
+
+    return 0;
+}
+
+static void rotate(float theta, float *left, float *right, int length)
+{
+    float c = cos(theta);
+    float s = sin(theta);
+    for (int i = 0; i < 2*length; i += 2) {
+        float l = left[i];
+        float r = right[i];
+        left[i]  =  c * l + s * r;
+        right[i] = -s * l + c * r;
+    }
+}
+
+static void mcr_upmix(AVS3AStereo *stereo, float *left, float *right)
+{
+    vector_fcopy(right, left, FRAME_LEN);
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(avs3a_mcr_sfb_table_fb) - 1; i++) {
+        int start = avs3a_mcr_sfb_table_fb[i];
+        int width = avs3a_mcr_sfb_table_fb[i + 1] - start;
+        rotate(-stereo->theta[0][i], left + 2*start,     right + 2*start,     width);
+        rotate(-stereo->theta[1][i], left + 2*start + 1, right + 2*start + 1, width);
+    }
+}
+
+static int decode_stereo_mcr(AVS3ADecoder *s, AVFrame *frame)
+{
+    GetBitContext *gb = s->gb;
+    int ret;
+
+    for (int i = 0; i < STEREO_CHANNELS; i++)
+        if ((ret = decode_core_side_bits(&s->core[i], gb)) < 0)
+            return ret;
+
+    decode_group_bits(&s->core[0], gb);
+    uint8_t nb_mdct_groups[1] = { s->core[0].nb_mdct_groups };
+
+    decode_stereo_side_bits(s);
+
+    int available_bits = calc_available_bits(s, nb_mdct_groups, 1);
+    int channel_bytes[1] = { available_bits / 8 };
+
+    if ((ret = inverse_qc(s, channel_bytes, 1)) < 0)
+        return ret;
+
+    mcr_upmix(&s->stereo, s->core[0].spectrum, s->core[1].spectrum);
+
+    for (int i = 0; i < STEREO_CHANNELS; i++)
+        post_synthesis(s, &s->core[i], (float *)frame->extended_data[i], 0);
+
+    return 0;
+}
+
+static int decode_mc(AVS3ADecoder *s, AVFrame *frame)
+{
+    GetBitContext *gb = s->gb;
+    AVS3AMC *mc = &s->mc;
+    int nb_channels = s->avctx->ch_layout.nb_channels;
+    uint8_t nb_mdct_groups[MAX_CHANNELS];
+    uint8_t bit_ratios[MAX_CHANNELS];
+    int channel_bytes[MAX_CHANNELS];
+    int ret;
+
+    for (int i = 0; i < nb_channels; i++)
+        if ((ret = decode_core_side_bits(&s->core[i], gb)) < 0)
+            return ret;
+
+    for (int i = 0; i < nb_channels; i++) {
+        decode_group_bits(&s->core[i], gb);
+        nb_mdct_groups[i] = s->core[i].nb_mdct_groups;
+    }
+
+    if ((ret = decode_mc_side_bits(mc, gb, nb_channels, bit_ratios)) < 0)
+        return ret;
+
+    int available_bits = calc_available_bits(s, nb_mdct_groups, nb_channels);
+
+    if ((ret = mc_bits_allocation_sil_flag(available_bits, bit_ratios, nb_channels,
+                                           channel_bytes, mc->sil_flag,
+                                           mc->lfe_bytes, mc->lf_ch_index)) < 0 ||
+        (ret = inverse_qc(s, channel_bytes, nb_channels)) < 0)
+        return ret;
+
+    mc_upmix(s, mc);
+
+    for (int i = 0; i < nb_channels; i++)
+        post_synthesis(s, &s->core[i], (float *)frame->extended_data[i],
+                       i == mc->lf_ch_index);
+
+    return 0;
+}
+
+static av_cold void build_mdct_window(float* window, int len)
+{
+    for (int i = 0; i < len; i++)
+        window[i] = sin((M_PI / (2.0f * len)) * (i + 0.5f));
+}
+
+static av_cold void avs3a_init_static_data(void)
+{
+    static VLCElem vlc_table[4400];
+    VLCInitState state = VLC_INIT_STATE(vlc_table);
+    for (int i = 0; i < 8; i++)
+        tns_coeff_vlc[i] = ff_vlc_init_tables(&state, 9, sizeof(tns_coeff_bits[i]),
+                                              tns_coeff_bits[i], 1, 1,
+                                              tns_coeff_codes[i], 2, 2, 0);
+    for (int i = 0; i < 16; i++)
+        parcor4[i] = sin((i - 8)*M_PI/2.0/(8 + (i < 8 ? 0.5 : -0.5)));
+    for (int i = 0; i <= 256; i++)
+        sin_table[i] = sin(i*M_PI/512.0);
+    build_mdct_window(long_window, FRAME_LEN);
+    build_mdct_window(short_window, BLOCK_LEN_SHORT);
+    build_mdct_window(hoa_window, HOA_OVERLAP_SIZE);
+}
+
+static av_cold int avs3a_decode_init(AVCodecContext *avctx)
+{
+    static AVOnce init_static_once = AV_ONCE_INIT;
+    AVS3ADecoder *s = avctx->priv_data;
+    s->avctx = avctx;
+
+    s->fdsp = avpriv_float_dsp_alloc(avctx->flags & AV_CODEC_FLAG_BITEXACT);
+    if (!s->fdsp)
+        return AVERROR(ENOMEM);
+
+    int ret;
+    float scale = -1.0f / sqrtf(FRAME_LEN / 2);
+    if ((ret = av_tx_init(&s->imdct_ctx, &s->imdct_fn, AV_TX_FLOAT_MDCT, 1,
+                          FRAME_LEN, &scale, AV_TX_FULL_IMDCT)) < 0)
+        return ret;
+
+    scale = -1.0f / sqrtf(BLOCK_LEN_SHORT / 2);
+    if ((ret = av_tx_init(&s->imdct_short_ctx, &s->imdct_short_fn, AV_TX_FLOAT_MDCT, 1,
+                          BLOCK_LEN_SHORT, &scale, AV_TX_FULL_IMDCT)) < 0)
+        return ret;
+
+    scale = 1.0f;
+    if ((ret = av_tx_init(&s->fft_ctx, &s->fft_fn, AV_TX_FLOAT_FFT, 0,
+                          FFT_TABLE_SIZE, &scale, 0)) < 0)
+        return ret;
+
+    scale = 1.0f / sqrtf(HOA_OVERLAP_SIZE / 2);
+    if ((ret = av_tx_init(&s->hoa_mdct_ctx, &s->hoa_mdct_fn, AV_TX_FLOAT_MDCT, 0,
+                          HOA_OVERLAP_SIZE, &scale, AV_TX_UNALIGNED)) < 0)
+        return ret;
+
+    scale = -1.0f / sqrtf(HOA_OVERLAP_SIZE / 2);
+    if ((ret = av_tx_init(&s->hoa_imdct_ctx, &s->hoa_imdct_fn, AV_TX_FLOAT_MDCT, 1,
+                          HOA_OVERLAP_SIZE, &scale, AV_TX_FULL_IMDCT)) < 0)
+        return ret;
+
+    ff_thread_once(&init_static_once, avs3a_init_static_data);
+
+    avctx->sample_fmt = AV_SAMPLE_FMT_FLTP;
+    return 0;
+}
+
+static av_cold int avs3a_decode_close(AVCodecContext *avctx)
+{
+    AVS3ADecoder *s = avctx->priv_data;
+    av_freep(&s->fdsp);
+    av_tx_uninit(&s->imdct_ctx);
+    av_tx_uninit(&s->imdct_short_ctx);
+    av_tx_uninit(&s->fft_ctx);
+    av_tx_uninit(&s->hoa_mdct_ctx);
+    av_tx_uninit(&s->hoa_imdct_ctx);
+    return 0;
+}
+
+static uint16_t avs3a_crc16(const uint8_t *data, size_t size)
+{
+    if (!size)
+        return 0xffff;
+    if (size == 1)
+        return 0xe1f0 ^ data[0];
+    return av_bswap16(av_crc(av_crc_get_table(AV_CRC_16_CCITT), 0x0f1d,
+                      data, size - 2)) ^ AV_RB16(data + size - 2);
+}
+
+static int avs3a_decode_frame(AVCodecContext *avctx, AVFrame *frame,
+                             int *got_frame_ptr, AVPacket *avpkt)
+{
+    AVS3ADecoder *s = avctx->priv_data;
+    GetBitContext gb;
+    int ret, bytes_per_frame, header_size;
+    AVS3AHeader header = {0};
+    int sample_rate;
+    uint16_t crc;
+
+    s->gb = &gb;
+    if ((ret = init_get_bits8(&gb, avpkt->data, avpkt->size)) < 0)
+        return ret;
+
+    if ((bytes_per_frame = ff_avs3a_parse_header(avctx, s->gb, &header_size,
+                                                 &header, &sample_rate, &crc)) < 0) {
+        av_log(avctx, AV_LOG_ERROR, "invalid header\n");
+        return bytes_per_frame;
+    }
+
+    if (get_bits_bytesize(&gb, 0) < bytes_per_frame) {
+        av_log(avctx, AV_LOG_ERROR, "truncated packet\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    if (avs3a_crc16(gb.buffer + header_size, bytes_per_frame - header_size) != crc) {
+        av_log(avctx, AV_LOG_ERROR, "crc failed\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    if (memcmp(&s->header, &header, sizeof(AVS3AHeader)) || avctx->sample_rate != sample_rate) {
+        AVChannelLayout ch_layout = {0};
+
+        if ((ret = ff_avs3a_get_ch_layout(avctx, &header, &ch_layout)) < 0)
+            return ret;
+        if (ch_layout.nb_channels > MAX_CHANNELS) {
+            av_channel_layout_uninit(&ch_layout);
+            return AVERROR_INVALIDDATA;
+        }
+        av_channel_layout_uninit(&avctx->ch_layout);
+        avctx->ch_layout = ch_layout;
+        s->header = header;
+        if ((ret = reset_decoder(s)) < 0) {
+            s->header = (AVS3AHeader){0};
+            return ret;
+        }
+        avctx->sample_rate = sample_rate;
+        avctx->bit_rate = header.bitrate;
+    }
+
+    parse_metadata(s);
+
+    frame->nb_samples = FRAME_LEN;
+    if ((ret = ff_get_buffer(avctx, frame, 0)) < 0)
+        return ret;
+
+    if (s->header.coding_profile == CODING_PROFILE_HOA)
+        ret = decode_hoa(s, frame);
+    else if (avctx->ch_layout.nb_channels == 1)
+        ret = decode_mono(s, frame);
+    else if (avctx->ch_layout.nb_channels == 2) {
+        if (!s->stereo.mcr)
+            ret = decode_stereo(s, frame);
+        else
+            ret = decode_stereo_mcr(s, frame);
+    } else
+        ret = decode_mc(s, frame);
+    if (ret < 0)
+        return ret;
+
+    *got_frame_ptr = 1;
+
+    return avpkt->size;
+}
+
+static av_cold void avs3a_flush(AVCodecContext *avctx)
+{
+      AVS3ADecoder *s = avctx->priv_data;
+      s->header = (AVS3AHeader){0};
+}
+
+const FFCodec ff_avs3a_decoder = {
+    .p.name         = "avs3a",
+    CODEC_LONG_NAME("AVS3-P3/AVS3A/Audio Vivid"),
+    .p.type         = AVMEDIA_TYPE_AUDIO,
+    .p.id           = AV_CODEC_ID_AVS3A,
+    .priv_data_size = sizeof(AVS3ADecoder),
+    .init           = avs3a_decode_init,
+    .close          = avs3a_decode_close,
+    FF_CODEC_DECODE_CB(avs3a_decode_frame),
+    .flush          = avs3a_flush,
+    .p.capabilities = AV_CODEC_CAP_CHANNEL_CONF |
+                      AV_CODEC_CAP_DR1 |
+                      AV_CODEC_CAP_SLICE_THREADS,
+    .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
+};
