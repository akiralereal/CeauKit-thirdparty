 }
+
+/* The SHA-256 of a certificate as it was sent: what a person compares two
+ * certificates by. Written as 64 lower-case hexadecimal digits. */
+static int cert_sha256(X509 *cert, char hex[65])
+{
+    uint8_t digest[EVP_MAX_MD_SIZE];
+    unsigned int size = 0;
 
+    if (!cert || X509_digest(cert, EVP_sha256(), digest, &size) != 1 || size != 32)
+        return AVERROR_UNKNOWN;
+    ff_data_to_hex(hex, digest, 32, 1);
+    return 0;
+}
+
+/* Whether a digest as a caller wrote it, in either case and with or without
+ * colons between its bytes, is the one in `hex`. */
+static int is_sha256(const char *stated, const char *hex)
+{
+    for (; *stated; stated++) {
+        if (*stated == ':' || *stated == ' ')
+            continue;
+        if (!*hex || av_tolower(*stated) != *hex)
+            return 0;
+        hex++;
+    }
+    return !*hex;
+}
+
+/* Judges the chain a server showed, in OpenSSL's place. The certificate the
+ * caller said it trusts (`trusted_cert_sha256`) is taken as it is: whatever
+ * else is the matter with it (no root, run out, written for another name),
+ * the peer that shows it holds its key, and that certificate is what was
+ * trusted. Any other is judged as OpenSSL would have judged it, against
+ * the roots and the name, and one that is turned down is kept, so that the
+ * caller can be told which it was. */
+static int verify_server_chain(X509_STORE_CTX *store, void *arg)
+{
+    TLSContext *c = arg;
+    char shown[65] = "";
+    int ok;
+
+    if (cert_sha256(X509_STORE_CTX_get0_cert(store), shown) < 0)
+        shown[0] = 0;
+    if (c->trusted_cert_sha256 && shown[0] && is_sha256(c->trusted_cert_sha256, shown)) {
+        X509_STORE_CTX_set_error(store, X509_V_OK);
+        return 1;
+    }
+    ok = X509_verify_cert(store);
+    if (ok <= 0)
+        av_strlcpy(c->refused_cert_sha256, shown, sizeof(c->refused_cert_sha256));
+    return ok;
+}
+
 static int tls_close(URLContext *h)
 {
     TLSContext *c = h->priv_data;
@@ -861,6 +917,11 @@
 
