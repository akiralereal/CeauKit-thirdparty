+#ifndef AVUTIL_HWCONTEXT_MEDIACODEC_INTERNAL_H
+#define AVUTIL_HWCONTEXT_MEDIACODEC_INTERNAL_H
+
+#include "hwcontext.h"
+
+/**
+ * What a decoder does when it is handed another surface: 0 when it draws
+ * into it from here on, a negative AVERROR code when it does not.
+ */
+typedef int (*AVMediaCodecSetSurface)(void *opaque, void *surface, void *native_window);
+
+/**
+ * Holds the device's surface and native_window as they are, from the lock
+ * to the unlock: a decoder reads them and takes its own references to what
+ * they name in between, so that neither is let go of under it by a caller
+ * that has just handed the device another surface.
+ */
+void avpriv_mediacodec_device_lock(AVHWDeviceContext *ctx);
+void avpriv_mediacodec_device_unlock(AVHWDeviceContext *ctx);
+
+/**
+ * Says that a running decoder draws into the device's surface, and how it
+ * is handed another (av_mediacodec_device_set_output_surface). A device
+ * moves one decoder: the last that was bound.
+ *
+ * The device may have been given another surface since the decoder read
+ * the one it was configured with, which was `surface` and `native_window`:
+ * then the decoder is handed that one here, before this returns.
+ */
+void avpriv_mediacodec_device_bind(AVHWDeviceContext *ctx, AVMediaCodecSetSurface set,
+                                   void *opaque, void *surface, void *native_window);
+
+/**
+ * Says that the decoder bound with `opaque` is being closed. When this has
+ * returned the device calls it no more.
+ */
+void avpriv_mediacodec_device_unbind(AVHWDeviceContext *ctx, void *opaque);
+
+#endif /* AVUTIL_HWCONTEXT_MEDIACODEC_INTERNAL_H */
