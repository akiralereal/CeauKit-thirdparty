+/* The device hands the running decoder another surface. Called with the
+ * device's lock held, on whatever thread asked the device, while this
+ * decoder is bound to it: so not before it has started, and not once its
+ * closing has begun. */
+static int mediacodec_dec_set_output_surface(void *opaque, void *surface, void *native_window)
+{
+    MediaCodecDecContext *s = opaque;
+    FFANativeWindow *current = s->surface;
+    FFANativeWindow *next;
+    int ret;
+
+    if (!s->codec || !current)
+        return AVERROR(EINVAL);
+
+    next = ff_mediacodec_surface_ref(surface, native_window, NULL);
+    if (!next)
+        return AVERROR_EXTERNAL;
+
+    ret = ff_AMediaCodec_setOutputSurface(s->codec, next);
+    if (ret < 0) {
+        ff_mediacodec_surface_unref(next, NULL);
+        return ret;
+    }
+
+    /* What the decoder holds of its surface changes hands inside the
+     * structure the decoding thread knows: that thread asks only whether
+     * there is one, and there still is. */
+    FFSWAP(FFANativeWindow, *current, *next);
+    ff_mediacodec_surface_unref(next, NULL);
+    av_log(NULL, AV_LOG_INFO, "MediaCodec %p draws into another surface\n", s->codec);
 
     return 0;
 }
