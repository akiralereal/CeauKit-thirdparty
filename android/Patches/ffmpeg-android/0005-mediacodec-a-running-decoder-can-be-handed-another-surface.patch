+static int mediacodec_ndk_setOutputSurface(FFAMediaCodec *ctx, FFANativeWindow *window)
+{
+    FFAMediaCodecNdk *codec = (FFAMediaCodecNdk *)ctx;
+    media_status_t status;
+    ANativeWindow *native_window = NULL;
+    ANativeWindow *from_surface = NULL;
+
+    if (!window)
+        return AVERROR(EINVAL);
+
+    if (window->surface) {
+        JNIEnv *env = NULL;
+        JNI_GET_ENV_OR_RETURN(env, ctx, AVERROR_EXTERNAL);
+        native_window = from_surface = ANativeWindow_fromSurface(env, window->surface);
+    } else {
+        native_window = window->native_window;
+    }
+    if (!native_window)
+        return AVERROR(EINVAL);
+
+    status = AMediaCodec_setOutputSurface(codec->impl, native_window);
+    if (status != AMEDIA_OK) {
+        av_log(codec, AV_LOG_ERROR, "setOutputSurface failed, %d\n", status);
+        if (from_surface)
+            ANativeWindow_release(from_surface);
+        return AVERROR_EXTERNAL;
     }
 
+    /* The window made of the surface at configure() was kept for delete()
+     * to release: the one made here takes its place. */
+    if (codec->window)
+        ANativeWindow_release(codec->window);
+    codec->window = from_surface;
+
     return 0;
 }
 
