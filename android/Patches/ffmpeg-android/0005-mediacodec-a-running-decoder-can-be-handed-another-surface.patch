+static int mediacodec_jni_setOutputSurface(FFAMediaCodec *ctx, FFANativeWindow *window)
+{
+    JNIEnv *env = NULL;
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)ctx;
+
+    JNI_GET_ENV_OR_RETURN(env, codec, AVERROR_EXTERNAL);
 
+    if (!codec->jfields.set_output_surface_id) {
+        av_log(ctx, AV_LOG_ERROR, "System doesn't support setOutputSurface\n");
+        return AVERROR(ENOSYS);
+    }
+    /* Through Java a decoder draws into a Surface, and a window that is
+     * known by its ANativeWindow alone is not one. */
+    if (!window || !window->surface) {
+        av_log(ctx, AV_LOG_ERROR, "setOutputSurface needs an android/view/Surface\n");
+        return AVERROR(EINVAL);
+    }
+
+    (*env)->CallVoidMethod(env, codec->object, codec->jfields.set_output_surface_id, window->surface);
+    if (ff_jni_exception_check(env, 1, codec) < 0)
+        return AVERROR_EXTERNAL;
+
+    return 0;
+}
