 #include "hwcontext.h"
 #include "hwcontext_internal.h"
 #include "hwcontext_mediacodec.h"
+#include "hwcontext_mediacodec_internal.h"
+#include "thread.h"
 
 typedef struct MediaCodecDeviceContext {
     AVMediaCodecDeviceContext ctx;
 
     void *libmedia;
     media_status_t (*create_surface)(ANativeWindow **surface);
+
+    /* Guards the surface a running decoder is moved to, and who is moved:
+     * a decoder is closed on one thread while whoever shows its pictures
+     * hands it another surface on another. */
+    AVMutex lock;
+    int has_lock;
+    /* The decoder that draws into the device's surface, while it runs. */
+    AVMediaCodecSetSurface set_surface;
+    void *decoder;
+    /* A decoder was bound once, and is no more. */
+    int decoder_has_closed;
 } MediaCodecDeviceContext;
 
+static int mc_device_lock(MediaCodecDeviceContext *s)
+{
+    if (!s->has_lock)
+        return 0;
+    ff_mutex_lock(&s->lock);
+    return 1;
+}
 
+int av_mediacodec_device_set_output_surface(AVHWDeviceContext *ctx,
+                                            void *surface, void *native_window)
+{
+    MediaCodecDeviceContext *s;
+    AVMediaCodecDeviceContext *dev;
+    int ret;
+
+    if (!ctx || ctx->type != AV_HWDEVICE_TYPE_MEDIACODEC || (!surface && !native_window))
+        return AVERROR(EINVAL);
+    s = ctx->hwctx;
+    dev = &s->ctx;
+    /* A device that was never initialised has no decoder either. */
+    if (!mc_device_lock(s))
+        return AVERROR(EINVAL);
+
+    if (s->set_surface) {
+        ret = s->set_surface(s->decoder, surface, native_window);
+    } else {
+        ret = s->decoder_has_closed ? 2 : 1;
+    }
+    if (ret >= 0) {
+        dev->surface = surface;
+        dev->native_window = native_window;
+    }
+
+    ff_mutex_unlock(&s->lock);
+    return ret;
+}
+
+void avpriv_mediacodec_device_lock(AVHWDeviceContext *ctx)
+{
+    MediaCodecDeviceContext *s = ctx->hwctx;
+
+    if (s->has_lock)
+        ff_mutex_lock(&s->lock);
+}
+
+void avpriv_mediacodec_device_unlock(AVHWDeviceContext *ctx)
+{
+    MediaCodecDeviceContext *s = ctx->hwctx;
+
+    if (s->has_lock)
+        ff_mutex_unlock(&s->lock);
+}
+
+void avpriv_mediacodec_device_bind(AVHWDeviceContext *ctx, AVMediaCodecSetSurface set,
+                                   void *opaque, void *surface, void *native_window)
+{
+    MediaCodecDeviceContext *s = ctx->hwctx;
+    AVMediaCodecDeviceContext *dev = &s->ctx;
+
+    if (!mc_device_lock(s))
+        return;
+    s->set_surface = set;
+    s->decoder = opaque;
+    s->decoder_has_closed = 0;
+    /* The device was handed another surface between the decoder reading
+     * the one it was configured with and its being bound here: that call
+     * found no decoder to move, and the surface the device has now is the
+     * one the decoder is to draw into. */
+    if ((dev->surface != surface || dev->native_window != native_window)
+        && (dev->surface || dev->native_window)) {
+        if (set(opaque, dev->surface, dev->native_window) < 0)
+            av_log(ctx, AV_LOG_WARNING,
+                   "The decoder did not take the surface its device was handed while it opened\n");
+    }
+    ff_mutex_unlock(&s->lock);
+}
+
+void avpriv_mediacodec_device_unbind(AVHWDeviceContext *ctx, void *opaque)
+{
+    MediaCodecDeviceContext *s = ctx->hwctx;
+
+    if (!mc_device_lock(s))
+        return;
+    if (s->decoder == opaque && s->set_surface) {
+        s->set_surface = NULL;
+        s->decoder = NULL;
+        s->decoder_has_closed = 1;
+    }
+    ff_mutex_unlock(&s->lock);
+}
+
