+struct AVHWDeviceContext;
+
+/**
+ * Hand the decoder that was opened with this device another surface to draw
+ * into, while it runs (android/media/MediaCodec#setOutputSurface, Android
+ * API 23). Buffers the decoder gave before and that are rendered after this
+ * returns go to the new surface; nothing of the decoder draws into the old
+ * one once this has returned.
+ *
+ * The device's own surface and native_window are set to the ones given
+ * whenever the call does not fail, so that a decoder opened with the device
+ * later is configured with them. As with the fields themselves, both have
+ * to stay valid for as long as the device may hand them to a decoder; a
+ * decoder that draws into them keeps references of its own.
+ *
+ * It may be called on any thread, also while the decoder is being fed,
+ * flushed or closed on another.
+ *
+ * @param ctx           a device of type AV_HWDEVICE_TYPE_MEDIACODEC
+ * @param surface       android/view/Surface reference. A decoder that
+ *                      reaches MediaCodec through Java needs it.
+ * @param native_window the same surface as an ANativeWindow, or NULL
+ * @return 0 when a running decoder draws into the new surface now;
+ *         1 when no decoder has been opened with the device yet: the next
+ *         one is configured with the new surface;
+ *         2 when the decoder that was opened with the device has been
+ *         closed. It may still be connected to the surface it drew into
+ *         last, until every buffer it gave is released;
+ *         a negative AVERROR code when the decoder did not take the
+ *         surface: it goes on drawing into the one it had, and the device's
+ *         fields are left as they were.
+ */
+int av_mediacodec_device_set_output_surface(struct AVHWDeviceContext *ctx,
+                                            void *surface, void *native_window);
+
 #endif /* AVUTIL_HWCONTEXT_MEDIACODEC_H */
