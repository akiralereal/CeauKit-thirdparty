+
+/* The roots a connection that names no file of its own is judged against:
+ * the ones in the file named in SSL_CERT_FILE, read once and shared by
+ * every such connection.
+ *
+ * OpenSSL reads that variable itself, but not in a process the kernel
+ * marked as started with other rights than its parent's (AT_SECURE), and
+ * an Android app's process is so marked (seen on Android 15): it would
+ * read nothing there, and every certificate would be turned down. The app
+ * names the file itself, after it has started, so nothing is taken from
+ * whoever started it.
+ *
+ * And OpenSSL read the file whole for every connection, ahead of its
+ * handshake: with Android's roots, 145 certificates, about 3 ms on an
+ * emulator on a fast Mac and more on a slow box, and a playlist's parts
+ * may each open a connection of their own. Here the file is looked at (its
+ * inode, size and time) at every connection and read again only when it
+ * has changed, so that roots written anew, one the user added or turned
+ * off, reach the next connection.
+ *
+ * 0 when no file is named or it cannot be read: the connection then reads
+ * OpenSSL's defaults, as it did before. */
+static AVMutex default_roots_mutex = AV_MUTEX_INITIALIZER;
+static X509_STORE *default_roots;
+static char *default_roots_path;
+static struct stat default_roots_file;
+
+static int use_shared_default_roots(TLSContext *c)
+{
+    const char *path = getenv(X509_get_default_cert_file_env());
+    struct stat file;
+    X509_STORE *roots = NULL;
+
+    if (!path || !*path || stat(path, &file) < 0)
+        return 0;
+    ff_mutex_lock(&default_roots_mutex);
+    if (default_roots && !strcmp(default_roots_path, path) &&
+        file.st_ino == default_roots_file.st_ino && file.st_size == default_roots_file.st_size &&
+        file.st_mtim.tv_sec == default_roots_file.st_mtim.tv_sec &&
+        file.st_mtim.tv_nsec == default_roots_file.st_mtim.tv_nsec) {
+        roots = default_roots;
+    } else if ((roots = X509_STORE_new()) && X509_STORE_load_file(roots, path) == 1) {
+        char *copy = av_strdup(path);
+        if (copy) {
+            /* A connection that took the roots read before keeps them. */
+            X509_STORE_free(default_roots);
+            av_free(default_roots_path);
+            default_roots = roots;
+            default_roots_path = copy;
+            default_roots_file = file;
+        } else {
+            X509_STORE_free(roots);
+            roots = NULL;
+        }
+    } else {
+        X509_STORE_free(roots);
+        roots = NULL;
+        ERR_clear_error();
+    }
+    if (roots)
+        SSL_CTX_set1_cert_store(c->ctx, roots);
+    ff_mutex_unlock(&default_roots_mutex);
+    return !!roots;
 }
 
