+#ifdef __ANDROID__
 /**
+ * \brief Whether the default font has a glyph for the character. Every font
+ * has one for 0, which is asked for a font's first face. The font is opened
+ * the first time and kept open.
+ */
+static bool default_font_has_glyph(ASS_FontSelector *priv, uint32_t code)
+{
+    if (!priv->path_default)
+        return false;
+    if (!code)
+        return true;
+    if (!priv->face_default && !priv->face_default_failed) {
+        priv->face_default = ass_face_open(priv->library, priv->ftlibrary,
+                priv->path_default, NULL, priv->index_default);
+        if (priv->face_default)
+            ass_charmap_magic(priv->library, priv->face_default);
+        else
+            priv->face_default_failed = true;
+    }
+    return priv->face_default && FT_Get_Char_Index(priv->face_default, code);
+}
+#endif
