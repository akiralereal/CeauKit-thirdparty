+/*
+ * Android's fonts, for the letters no other font has.
+ *
+ * Android has no font service libass knows (Core Text, fontconfig,
+ * DirectWrite), but it says, through the NDK's AFontMatcher (Android 10,
+ * API 29), which of its fonts its own text stack draws a letter in. That is
+ * what this provider asks, for a letter that none of the fonts already
+ * chosen for a line has: an Arabic, Hebrew, Thai or Devanagari letter in a
+ * line whose font is the host's font for Chinese, say. It answers with the
+ * system's font that has the letter, which libass then opens by its path,
+ * as it opens any font file: read through FreeType as it is needed, never
+ * whole into memory.
+ *
+ * It does nothing else. Android lists its fonts (ASystemFontIterator) but
+ * not what they are called, and its matcher knows only its own family
+ * names (sans-serif, serif, and aliases such as Arial for sans-serif), so a
+ * style's font could be found among the system's only by opening every
+ * font the system has. A style's font is looked for among the media's fonts
+ * and the host's only, as it was before this provider; and the font the
+ * host stated as the default keeps every letter it has (ass_font_select in
+ * ass_fontselect.c asks this provider only for the letters that font
+ * lacks). What a line looked like with no provider at all is what it looks
+ * like now, less the empty boxes.
+ *
+ * AFontMatcher answers from the font collection Android sets up in an
+ * app's process before the app's code runs. A program started from a shell
+ * has none, and AFontMatcher_match crashes there (seen on Android 15): this
+ * provider is for libass loaded by an app.
+ *
+ * Each font found is listed under a family name of its own, which is what
+ * get_fallback answers and nothing else is called, so the font libass
+ * selects for that answer is that font and no other. Its bold, where the
+ * system has a separate file for it (Noto Sans Thai, Hebrew, Naskh Arabic),
+ * is listed under the same name, so that a bold line takes it rather than
+ * a regular one made bold.
+ */
+
+#include "config.h"
+#include "ass_compat.h"
+
+#ifdef __ANDROID__
+
+#include <android/font.h>
+#include <android/font_matcher.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <ft2build.h>
+#include FT_FREETYPE_H
+
+#include "ass_android.h"
+#include "ass_font.h"
+#include "ass_utils.h"
+
+/* Letters remembered with their answer: libass asks again for a letter no
+ * font has each time a line holding it is laid out. */
+#define REMEMBERED_LETTERS 256
+
+/* The family Android's fallback fonts are looked up in. A style's own
+ * family is not passed: Android knows a handful of family names (its
+ * aliases for Arial and Times among them), and for those it would answer
+ * with a font for Latin a style never asked for, where every other name
+ * falls through to this one anyway. */
+#define SYSTEM_FAMILY "sans-serif"
+
+typedef struct {
+    FT_Face face;   // the font's, for asking which letters it has
+} AndroidFontData;
+
+typedef struct {
+    char *path;
+    int index;
+    int family;     // index into the provider's family names
+    AndroidFontData *data;  // the selector's: freed by destroy_font
+} AndroidFont;
+
+typedef struct {
+    ASS_Library *library;
+    FT_Library ftlibrary;
+    ASS_FontProvider *provider;
+    AFontMatcher *matcher;
+
+    AndroidFont *fonts;
+    int n_fonts;
+    int alloc_fonts;
+
+    char **families;
+    int n_families;
+    int alloc_families;
+
+    struct {
+        uint32_t letter;    // 0: nothing remembered here
+        int family;         // -1: no font of the system's has it
+    } remembered[REMEMBERED_LETTERS];
+} AndroidProvider;
+
+static bool has_letter(FT_Face face, uint32_t letter)
+{
+    return face && FT_Get_Char_Index(face, letter) != 0;
+}
+
+static bool check_glyph(void *data, uint32_t codepoint)
+{
+    AndroidFontData *font = data;
+    return !codepoint || has_letter(font->face, codepoint);
+}
+
+static void destroy_font(void *data)
+{
+    AndroidFontData *font = data;
+    if (font->face)
+        FT_Done_Face(font->face);
+    free(font);
+}
+
+static void destroy_provider(void *data)
+{
+    AndroidProvider *android = data;
+    // The fonts' own data went with destroy_font, before this.
+    for (int i = 0; i < android->n_fonts; i++)
+        free(android->fonts[i].path);
+    free(android->fonts);
+    for (int i = 0; i < android->n_families; i++)
+        free(android->families[i]);
+    free(android->families);
+    if (android->matcher)
+        AFontMatcher_destroy(android->matcher);
+    free(android);
+}
+
+/* The letter as UTF-16, which is what AFontMatcher reads. */
+static uint32_t utf16(uint32_t letter, uint16_t text[2])
+{
+    if (letter < 0x10000) {
+        text[0] = (uint16_t) letter;
+        return 1;
+    }
+    letter -= 0x10000;
+    text[0] = (uint16_t) (0xD800 + (letter >> 10));
+    text[1] = (uint16_t) (0xDC00 + (letter & 0x3FF));
+    return 2;
+}
+
+static int known_font(AndroidProvider *android, const char *path, int index)
+{
+    for (int i = 0; i < android->n_fonts; i++)
+        if (android->fonts[i].index == index && !strcmp(android->fonts[i].path, path))
+            return i;
+    return -1;
+}
+
+/* A family name for the fonts found next, one no real family has. */
+static int new_family(AndroidProvider *android)
+{
+    if (android->n_families >= android->alloc_families) {
+        int alloc = FFMAX(8, 2 * android->alloc_families);
+        char **families = realloc(android->families, alloc * sizeof(char *));
+        if (!families)
+            return -1;
+        android->families = families;
+        android->alloc_families = alloc;
+    }
+    char name[48];
+    snprintf(name, sizeof(name), "ceau-android-fallback-%d", android->n_families);
+    char *copy = strdup(name);
+    if (!copy)
+        return -1;
+    android->families[android->n_families] = copy;
+    return android->n_families++;
+}
+
+/*
+ * Lists the font AFontMatcher answered with under the family, with libass
+ * and here. The font is opened to be asked which letters it has, and kept
+ * open for that: the face is FreeType's view of the file, which reads it
+ * as it is asked. Returns the font's place here, or -1.
+ */
+static int add_font(AndroidProvider *android, AFont *found, int family)
+{
+    const char *path = AFont_getFontFilePath(found);
+    int index = (int) AFont_getCollectionIndex(found);
+    if (!path || !*path)
+        return -1;
+    FT_Face face = ass_face_open(android->library, android->ftlibrary, path, NULL, index);
+    if (!face)
+        return -1;
+    ass_charmap_magic(android->library, face);
+
+    if (android->n_fonts >= android->alloc_fonts) {
+        int alloc = FFMAX(8, 2 * android->alloc_fonts);
+        AndroidFont *fonts = realloc(android->fonts, alloc * sizeof(AndroidFont));
+        if (!fonts) {
+            FT_Done_Face(face);
+            return -1;
+        }
+        android->fonts = fonts;
+        android->alloc_fonts = alloc;
+    }
+    char *path_copy = strdup(path);
+    AndroidFontData *data = calloc(1, sizeof(AndroidFontData));
+    if (!path_copy || !data) {
+        free(path_copy);
+        free(data);
+        FT_Done_Face(face);
+        return -1;
+    }
+    data->face = face;
+
+    char *name = android->families[family];
+    ASS_FontProviderMetaData meta = {
+        .families = &name,
+        .n_family = 1,
+        .extended_family = name,
+        .weight = AFont_getWeight(found),
+        .style_flags = AFont_isItalic(found) ? FT_STYLE_FLAG_ITALIC : 0,
+    };
+    // On failure libass has destroyed the font's data itself.
+    if (!ass_font_provider_add_font(android->provider, &meta, path, index, data)) {
+        free(path_copy);
+        return -1;
+    }
+    AndroidFont *font = &android->fonts[android->n_fonts];
+    font->path = path_copy;
+    font->index = index;
+    font->family = family;
+    font->data = data;
+    ass_msg(android->library, MSGL_INFO, "android: listed %s, %d (weight %d) as %s",
+            path, index, meta.weight, name);
+    return android->n_fonts++;
+}
+
+/*
+ * The family of the system's font for the letter: the font Android's text
+ * stack draws it in, and the bold of that font where it has a file of its
+ * own. -1 when that font does not have the letter either: AFontMatcher
+ * answers with some font whatever the letter, so that a box is drawn.
+ */
+static int family_for(AndroidProvider *android, uint32_t letter)
+{
+    uint16_t text[2];
+    uint32_t length = utf16(letter, text);
+
+    AFontMatcher_setStyle(android->matcher, AFONT_WEIGHT_NORMAL, false);
+    AFont *regular = AFontMatcher_match(android->matcher, SYSTEM_FAMILY, text, length, NULL);
+    const char *path = AFont_getFontFilePath(regular);
+    int known = path ? known_font(android, path, (int) AFont_getCollectionIndex(regular)) : -1;
+    if (known < 0) {
+        int family = new_family(android);
+        known = family < 0 ? -1 : add_font(android, regular, family);
+        if (known >= 0) {
+            AFontMatcher_setStyle(android->matcher, AFONT_WEIGHT_BOLD, false);
+            AFont *bold = AFontMatcher_match(android->matcher, SYSTEM_FAMILY, text, length, NULL);
+            const char *bold_path = AFont_getFontFilePath(bold);
+            if (bold_path && known_font(android, bold_path, (int) AFont_getCollectionIndex(bold)) < 0)
+                add_font(android, bold, family);
+            AFont_close(bold);
+        }
+    }
+    AFont_close(regular);
+    if (known < 0 || !has_letter(android->fonts[known].data->face, letter))
+        return -1;
+    return android->fonts[known].family;
+}
+
+static char *get_fallback(void *data, ASS_Library *lib, const char *family,
+                          uint32_t codepoint)
+{
+    AndroidProvider *android = data;
+    // 0 is asked for a line's first font, when the host stated no default
+    // font: the system's font for Latin then.
+    uint32_t letter = codepoint ? codepoint : 'a';
+    unsigned slot = letter % REMEMBERED_LETTERS;
+    int found;
+    if (android->remembered[slot].letter == letter) {
+        found = android->remembered[slot].family;
+    } else {
+        found = family_for(android, letter);
+        android->remembered[slot].letter = letter;
+        android->remembered[slot].family = found;
+        if (found < 0)
+            ass_msg(lib, MSGL_INFO, "android: no font of the system's has U+%04X", letter);
+    }
+    return found < 0 ? NULL : strdup(android->families[found]);
+}
+
+static ASS_FontProviderFuncs android_callbacks = {
+    .check_glyph        = check_glyph,
+    .destroy_font       = destroy_font,
+    .destroy_provider   = destroy_provider,
+    .get_fallback       = get_fallback,
+};
+
+ASS_FontProvider *
+ass_android_add_provider(ASS_Library *lib, ASS_FontSelector *selector,
+                         const char *config, FT_Library ftlib)
+{
+    AndroidProvider *android = calloc(1, sizeof(AndroidProvider));
+    if (!android)
+        return NULL;
+    android->library = lib;
+    android->ftlibrary = ftlib;
+    android->matcher = AFontMatcher_create();
+    // The fonts made for running text rather than for a compact interface:
+    // Noto Sans Thai and not Noto Sans Thai UI, whose marks are squeezed
+    // into a Latin line's height.
+    AFontMatcher_setFamilyVariant(android->matcher, AFAMILY_VARIANT_ELEGANT);
+    android->provider = ass_font_provider_new(selector, &android_callbacks, android);
+    if (!android->provider) {
+        AFontMatcher_destroy(android->matcher);
+        free(android);
+        return NULL;
+    }
+    return android->provider;
+}
+
+#endif
