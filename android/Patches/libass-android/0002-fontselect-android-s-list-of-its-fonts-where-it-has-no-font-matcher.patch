+/*
+ * The same from the system's list of its fonts, where there is no matcher
+ * to ask: the family of the first font that has the letter, among the fonts
+ * found for earlier letters and then down the list. -1 when none has it.
+ *
+ * A font found is kept open, as the matcher's are. One that lacks the
+ * letter is closed again: a list has some two hundred families, and a face
+ * is the whole file mapped, which a 32-bit process has no room to keep two
+ * hundred of. So a letter no font has costs a look into every file once,
+ * and is remembered (get_fallback); the letters of a script are found in
+ * the font its first letter was found in, without a look into any file.
+ */
+static int family_from_list(AndroidProvider *android, uint32_t letter)
+{
+    for (int i = 0; i < android->n_fonts; i++)
+        if (has_letter(android->fonts[i].data->face, letter))
+            return android->fonts[i].family;
+    if (!android->list)
+        return -1;
+    for (int i = 0; i < android->list->n_families; i++) {
+        if (android->list_state[i] != FAMILY_UNTRIED)
+            continue;
+        const ASS_AndroidFontFamily *listed = &android->list->families[i];
+        FT_Face face = NULL;
+        // Not ass_face_open: a list may name a file the device does not
+        // have, and that is nothing to warn of for every letter.
+        if (FT_New_Face(android->ftlibrary, listed->path, listed->index, &face)) {
+            android->list_state[i] = FAMILY_UNUSABLE;
+            continue;
+        }
+        ass_charmap_magic(android->library, face);
+        bool has = has_letter(face, letter);
+        FT_Done_Face(face);
+        if (!has)
+            continue;
+        int family = new_family(android);
+        int known = family < 0 ? -1
+            : add_font(android, listed->path, listed->index, 400, false, family);
+        android->list_state[i] = known < 0 ? FAMILY_UNUSABLE : FAMILY_LISTED;
+        if (known < 0)
+            continue;
+        if (listed->bold_path)
+            add_font(android, listed->bold_path, listed->bold_index, 700, false, family);
+        return family;
+    }
+    return -1;
 }
 
