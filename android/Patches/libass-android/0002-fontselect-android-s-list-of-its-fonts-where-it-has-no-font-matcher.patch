+/*
+ * Android's own list of its fonts, /system/etc/fonts.xml, as far as a
+ * letter's font is found from it (ass_android_fonts.h).
+ *
+ * The list is XML of one plain shape, which every Android since 5 has had:
+ *
+ *   <familyset>
+ *     <family name="sans-serif">                  the default family, first
+ *       <font weight="400" style="normal">Roboto-Regular.ttf</font> ...
+ *     </family>
+ *     <family name="serif"> ... </family>         families asked for by name
+ *     <family lang="und-Arab" variant="elegant">  families fallen back on:
+ *       <font weight="400" style="normal">NotoNaskhArabic-Regular.ttf</font>
+ *       <font weight="700" style="normal">NotoNaskhArabic-Bold.ttf</font>
+ *     </family>                                   no name, tried in order
+ *     <family lang="zh-Hans">
+ *       <font weight="400" style="normal" index="2">NotoSansCJK-Regular.ttc</font>
+ *       <font weight="400" style="normal" index="2" fallbackFor="serif">NotoSerifCJK-Regular.ttc</font>
+ *     </family>
+ *   </familyset>
+ *
+ * It is read by hand, tag by tag: libass has no XML reader, and one is not
+ * needed for this. A file a device's maker changed, or one cut short, gives
+ * the families that could be read and never a read beyond the text.
+ */
+
+#include "ass_android_fonts.h"
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* More than any list has (Android 15's has some 250), and the most that is
+ * read of a file that is not a list at all. */
+#define MAX_FAMILIES 1024
+#define MAX_FILE_SIZE (4 * 1024 * 1024)
+
+static bool is_space(char c)
+{
+    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
+}
+
+static bool is_name(char c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
+        || c == '_' || c == '-' || c == ':' || c == '.';
+}
+
+/* The first place at or after `from` where `text` stands, or NULL. */
+static const char *find(const char *from, const char *end, const char *text)
+{
+    size_t length = strlen(text);
+    for (; from + length <= end; from++)
+        if (*from == text[0] && !memcmp(from, text, length))
+            return from;
+    return NULL;
+}
+
+/* The '>' that closes the tag whose text begins at `from`: one inside an
+ * attribute's quotes does not. NULL when the tag is not closed. */
+static const char *tag_end(const char *from, const char *end)
+{
+    char quote = 0;
+    for (; from < end; from++) {
+        if (quote) {
+            if (*from == quote)
+                quote = 0;
+        } else if (*from == '"' || *from == '\'') {
+            quote = *from;
+        } else if (*from == '>') {
+            return from;
+        }
+    }
+    return NULL;
+}
+
+/*
+ * The value of an attribute among those of a tag, `from` being where they
+ * begin and `end` the tag's '>'. Written to `value`, cut to what it holds.
+ * False when the tag has no such attribute.
+ */
+static bool attribute(const char *from, const char *end, const char *name,
+                      char *value, size_t value_size)
+{
+    size_t name_length = strlen(name);
+    while (from < end) {
+        while (from < end && !is_name(*from))
+            from++;
+        const char *start = from;
+        while (from < end && is_name(*from))
+            from++;
+        size_t length = (size_t) (from - start);
+        while (from < end && is_space(*from))
+            from++;
+        if (from >= end || *from != '=')
+            continue;   // a word with no value: not an attribute
+        from++;
+        while (from < end && is_space(*from))
+            from++;
+        if (from >= end || (*from != '"' && *from != '\''))
+            continue;
+        char quote = *from++;
+        const char *text = from;
+        while (from < end && *from != quote)
+            from++;
+        if (from >= end)
+            return false;
+        if (length == name_length && !memcmp(start, name, length)) {
+            size_t size = (size_t) (from - text);
+            if (size >= value_size)
+                size = value_size - 1;
+            memcpy(value, text, size);
+            value[size] = 0;
+            return true;
+        }
+        from++;
+    }
+    return false;
+}
+
+/* What a family has been found to hold while its fonts are read. */
+typedef struct {
+    char *path;
+    int index;
+    int distance;       // of the font's weight from the one looked for
+} Candidate;
+
+/* The font is the family's, unless one nearer the weight was met before. */
+static void take(Candidate *candidate, const char *path, int index, int distance)
+{
+    if (candidate->path && candidate->distance <= distance)
+        return;
+    char *copy = strdup(path);
+    if (!copy)
+        return;
+    free(candidate->path);
+    candidate->path = copy;
+    candidate->index = index;
+    candidate->distance = distance;
+}
+
+/*
+ * The text of a font element: the file's name, without the white space
+ * around it or the elements in it (<axis>, of a font that varies). `from`
+ * is after the font tag's '>' and `to` where "</font" begins.
+ */
+static char *font_file(const char *from, const char *to, const char *folder)
+{
+    size_t folder_length = strlen(folder);
+    char *path = malloc(folder_length + 1 + (size_t) (to - from) + 1);
+    if (!path)
+        return NULL;
+    char *name = path + folder_length + 1;
+    size_t length = 0;
+    bool inside = false;
+    for (; from < to; from++) {
+        if (*from == '<')
+            inside = true;
+        else if (*from == '>')
+            inside = false;
+        else if (!inside && !is_space(*from))
+            name[length++] = *from;
+    }
+    name[length] = 0;
+    if (!length) {
+        free(path);
+        return NULL;
+    }
+    if (name[0] == '/') {
+        // A file named with its whole path, which later lists allow.
+        memmove(path, name, length + 1);
+    } else {
+        memcpy(path, folder, folder_length);
+        path[folder_length] = '/';
+    }
+    return path;
+}
