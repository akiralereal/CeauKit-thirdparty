+#ifndef LIBASS_ANDROID_FONTS_H
+#define LIBASS_ANDROID_FONTS_H
+
+#include <stddef.h>
+
+/*
+ * Android's own list of its fonts (/system/etc/fonts.xml), read for the
+ * fonts its text stack falls back on, in the order it tries them. This is
+ * what Android's provider goes by on Android 9, which has no font matcher
+ * to ask (ass_android.c).
+ *
+ * It has nothing of libass or of Android in it, so that it can be checked
+ * on any system.
+ */
+
+/* A family of the list: its upright font of regular weight, and its bold
+ * where that is a file or a face of its own. */
+typedef struct {
+    char *path;
+    int index;
+    char *bold_path;    // NULL: the family has no bold of its own
+    int bold_index;
+} ASS_AndroidFontFamily;
+
+typedef struct {
+    ASS_AndroidFontFamily *families;
+    int n_families;
+} ASS_AndroidFontList;
+
+/*
+ * The families a letter is looked for in, in the list's order: the first
+ * family of the list, which is the default one (sans-serif), and every
+ * family after it that has no name, which are the ones the system falls
+ * back on. Font files are named in the folder given. NULL when memory runs
+ * out; a text that is not such a list gives a list of no families.
+ */
+ASS_AndroidFontList *ass_android_font_list_parse(const char *xml, size_t size,
+                                                 const char *folder);
+
+/* The same of a file. NULL when it cannot be read too. */
+ASS_AndroidFontList *ass_android_font_list_read(const char *file,
+                                                const char *folder);
+
+void ass_android_font_list_free(ASS_AndroidFontList *list);
+
+#endif
