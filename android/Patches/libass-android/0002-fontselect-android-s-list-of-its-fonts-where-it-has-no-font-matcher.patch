+ASS_AndroidFontList *ass_android_font_list_parse(const char *xml, size_t size,
+                                                 const char *folder)
+{
+    ASS_AndroidFontList *list = calloc(1, sizeof(*list));
+    if (!list)
+        return NULL;
+    int allocated = 0;
+    int seen = 0;               // families met, the ones passed over too
+    bool in_family = false;
+    bool passed_over = false;   // this family is not one a letter is looked for in
