+            char value[64];
+            int weight = attribute(at, close, "weight", value, sizeof(value)) ? atoi(value) : 400;
+            int index = attribute(at, close, "index", value, sizeof(value)) ? atoi(value) : 0;
+            bool upright = !attribute(at, close, "style", value, sizeof(value)) || !strcmp(value, "normal");
+            // A font named for another family (the serif one for Chinese)
+            // is not the one this family is drawn in.
+            bool another = attribute(at, close, "fallbackFor", value, sizeof(value));
+            char *path = (passed_over || !upright || another || index < 0)
+                ? NULL : font_file(text, text_end, folder);
+            if (path) {
+                take(&regular, path, index, abs(weight - 400));
+                if (weight >= 600)
+                    take(&bold, path, index, abs(weight - 700));
+                free(path);
+            }
+            close = text_end;
+        }
+        at = close + 1;
+    }
+    free(regular.path);
+    free(bold.path);
+    return list;
+}
+
+ASS_AndroidFontList *ass_android_font_list_read(const char *file,
+                                                const char *folder)
+{
+    FILE *stream = fopen(file, "rb");
+    if (!stream)
+        return NULL;
+    size_t size = 0, allocated = 64 * 1024;
+    char *text = malloc(allocated);
+    while (text) {
+        size += fread(text + size, 1, allocated - size, stream);
+        if (size < allocated || allocated >= MAX_FILE_SIZE)
+            break;
+        allocated *= 2;
+        char *more = realloc(text, allocated);
+        if (!more) {
+            free(text);
+            text = NULL;
+        } else {
+            text = more;
+        }
+    }
+    fclose(stream);
+    if (!text)
+        return NULL;
+    ASS_AndroidFontList *list = ass_android_font_list_parse(text, size, folder);
+    free(text);
+    return list;
+}
+
+void ass_android_font_list_free(ASS_AndroidFontList *list)
+{
+    if (!list)
+        return;
+    for (int i = 0; i < list->n_families; i++) {
+        free(list->families[i].path);
+        free(list->families[i].bold_path);
+    }
+    free(list->families);
+    free(list);
+}
