+            const char *close = find(at + 3, end, "-->");
+            if (!close)
+                break;
+            at = close + 3;
+            continue;
+        }
+        const char *close = tag_end(at, end);
+        if (!close)
+            break;
+        const char *word = at;
+        while (at < close && (is_name(*at) || *at == '/'))
+            at++;
+        size_t word_length = (size_t) (at - word);
+        // `at` is where the tag's attributes begin.
+
+        if (word_length == 6 && !memcmp(word, "family", 6)) {
+            char value[64];
+            in_family = close[-1] != '/';
+            // The first family is the default one whatever it is called. A
+            // later family with a name is drawn in only when a style asks
+            // for it by that name, which libass never asks of Android. Of
+            // a script's two families the one made for running text is
+            // kept, and the one squeezed for an interface passed over.
+            passed_over = (seen > 0 && attribute(at, close, "name", value, sizeof(value)))
+                || (attribute(at, close, "variant", value, sizeof(value)) && !strcmp(value, "compact"));
+            seen++;
+            free(regular.path);
+            free(bold.path);
+            regular = (Candidate) {0};
+            bold = (Candidate) {0};
+        } else if (word_length == 7 && !memcmp(word, "/family", 7)) {
